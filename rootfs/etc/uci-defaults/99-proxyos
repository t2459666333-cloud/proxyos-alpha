#!/bin/sh

set -eu

physical_interfaces() {
	net_class_root="${PROXYOS_NET_CLASS_ROOT:-/sys/class/net}"
	for net_path in "$net_class_root"/*; do
		[ -e "$net_path" ] || continue
		iface="${net_path##*/}"
		case "$iface" in
			lo|br-*|docker*|veth*|tun*|tap*|wg*|proxyos*) continue ;;
		esac
		[ "$(cat "${net_path}/type" 2>/dev/null || true)" = "1" ] || continue
		[ -e "${net_path}/device" ] || continue
		# A wireless station also reports ARPHRD_ETHER and has a device
		# symlink. Never let it become the default WAN or a LAN bridge member.
		[ ! -e "${net_path}/phy80211" ] || continue
		[ ! -d "${net_path}/wireless" ] || continue
		device_path="$(readlink -f "${net_path}/device" 2>/dev/null || printf '%s' "$iface")"
		printf '%s|%s\n' "$device_path" "$iface"
	done | sort | cut -d '|' -f 2
}

ports="$(physical_interfaces)"
port_count="$(printf '%s\n' "$ports" | sed '/^$/d' | wc -l)"

uci set system.@system[0].hostname='ProxyOS'
uci commit system

# The generic x86 image already contains an anonymous br-lan device section.
# Remove it before creating ProxyOS' named section so a physical port can never
# remain configured as both WAN and LAN after first boot.
while :; do
	legacy_br_lan="$(
		uci -q show network |
			sed -n "s/^network\.\(@device\[[0-9][0-9]*\]\)\.name='br-lan'$/\1/p" |
			sed -n '1p'
	)"
	[ -n "$legacy_br_lan" ] || break
	uci -q delete "network.${legacy_br_lan}"
done

if [ "$port_count" -ge 2 ]; then
	wan_port="$(printf '%s\n' "$ports" | sed -n '1p')"
	lan_ports="$(printf '%s\n' "$ports" | sed -n '2,$p')"

	uci -q batch <<-EOF
		set network.wan='interface'
		set network.wan.proto='dhcp'
		set network.wan.device='${wan_port}'
		set network.br_lan='device'
		set network.br_lan.name='br-lan'
		set network.br_lan.type='bridge'
		delete network.br_lan.ports
		set network.lan='interface'
		set network.lan.device='br-lan'
		set network.lan.proto='static'
		set network.lan.ipaddr='192.168.10.1'
		set network.lan.netmask='255.255.255.0'
	EOF
	for lan_port in $lan_ports; do
		uci add_list "network.br_lan.ports=${lan_port}"
	done
else
	only_port="$(printf '%s\n' "$ports" | sed -n '1p')"
	uci -q batch <<-EOF
		delete network.wan
		set network.br_lan='device'
		set network.br_lan.name='br-lan'
		set network.br_lan.type='bridge'
		delete network.br_lan.ports
		set network.lan='interface'
		set network.lan.device='br-lan'
		set network.lan.proto='static'
		set network.lan.ipaddr='192.168.10.1'
		set network.lan.netmask='255.255.255.0'
	EOF
	[ -z "$only_port" ] || uci add_list "network.br_lan.ports=${only_port}"
fi
uci commit network

uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.dhcp_option
# LAN clients must use ProxyOS for DNS so device policy and leak protection
# remain effective. The address is intentionally the stable management IP.
uci add_list dhcp.lan.dhcp_option='6,192.168.10.1'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'
uci commit dhcp
uci -q delete network.wan6
uci set network.lan.delegate='0'
uci commit network

uci set uhttpd.main.home='/www'
uci set uhttpd.main.ubus_prefix='/ubus'
uci set uhttpd.main.rfc1918_filter='1'
uci commit uhttpd

# Generate radio sections when a supported adapter exists, but keep every
# radio disabled until the user explicitly enables Wi-Fi in the ProxyOS UI.
if [ -d /sys/class/ieee80211 ] &&
	ls /sys/class/ieee80211/* >/dev/null 2>&1 &&
	! uci -q show wireless | grep -q '=wifi-device$'; then
	wifi config >/dev/null 2>&1 || true
fi
for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
	uci set "wireless.${radio}.disabled=1"
done
uci commit wireless

/etc/init.d/sing-box disable >/dev/null 2>&1 || true
/etc/init.d/proxyos enable
/etc/init.d/proxyos-health enable
/etc/init.d/proxyos-port-detect enable
/etc/init.d/proxyos-platform-doctor enable
/etc/init.d/proxyos-lan-watch enable
/etc/init.d/rpcd reload >/dev/null 2>&1 || true

exit 0
