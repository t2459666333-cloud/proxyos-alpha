#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/sing-box"
CONFIG="/etc/proxyos/sing-box.json"
CTL="/usr/libexec/proxyos/proxyosctl"

start_service() {
	uci -q get proxyos.main.enabled | grep -qx '1' || return 0
	"$CTL" generate >/dev/null 2>&1 || return 1
	"$CTL" block-firewall-sync >/dev/null 2>&1 || return 1
	"$PROG" check -c "$CONFIG" >/tmp/proxyos-singbox-check.log 2>&1 || return 1

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONFIG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger proxyos
}
