#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

CTL="/usr/libexec/proxyos/proxyosctl"

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c "while true; do sleep 300; ${CTL} health-check >/dev/null 2>&1 || true; done"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
