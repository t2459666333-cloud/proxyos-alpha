#!/bin/sh /etc/rc.common

START=94
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c 'i=0; while [ "$i" -lt 30 ]; do ip route show default 2>/dev/null | grep -q "^default " && break; i=$((i+1)); sleep 1; done; /usr/sbin/proxyos-platform-doctor'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 10 3
	procd_close_instance
}

