#!/bin/sh
set -eu

STATE_DIR="${PROXYOS_STATE_DIR:-/etc/proxyos}"
NODES_FILE="${STATE_DIR}/nodes.json"
DEVICES_FILE="${STATE_DIR}/devices.json"
SUBSCRIPTIONS_FILE="${STATE_DIR}/subscriptions.json"
TEMPLATE_FILE="${STATE_DIR}/config-template.json"
ACTIVE_CONFIG="${STATE_DIR}/sing-box.json"
LAST_GOOD_CONFIG="${STATE_DIR}/sing-box.last-good.json"
PARSER="${PROXYOS_PARSER:-/usr/libexec/proxyos/subscription_parser.py}"
PYTHON="${PROXYOS_PYTHON:-python3}"
SINGBOX="${PROXYOS_SINGBOX:-/usr/bin/sing-box}"
PORT_ROLLBACK_FLAG="/tmp/proxyos-port-rollback.pending"
PORT_ROLLBACK_CONFIG="/tmp/proxyos-network.rollback"
VERSION_FILE="${STATE_DIR}/version"

proxyos_version() {
	cat "$VERSION_FILE" 2>/dev/null || printf '0.3.0-rc3'
}

json_error() {
	printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
	# rpcd discards a plugin's JSON body when the process exits non-zero and
	# exposes only a numeric UBUS error. Return a successful transport status
	# and let the explicit ok:false payload reach the web client.
	exit 0
}

json_ok() {
	printf '{"ok":true%s}\n' "${1:+,$1}"
}

require_commands() {
	for required_command in jq uci ubus; do
		command -v "$required_command" >/dev/null 2>&1 || json_error "Missing command: ${required_command}"
	done
}

ensure_state() {
	mkdir -p "$STATE_DIR"
	[ -s "$NODES_FILE" ] || printf '[]\n' > "$NODES_FILE"
	[ -s "$DEVICES_FILE" ] || printf '[]\n' > "$DEVICES_FILE"
	[ -s "$SUBSCRIPTIONS_FILE" ] || printf '[]\n' > "$SUBSCRIPTIONS_FILE"
	# rpcd starts one proxyosctl process per method. A fixed migration
	# filename lets concurrent dashboard requests overwrite each other.
	if ! jq -e 'all(.[];
		has("backup_node_id") and has("failure_mode") and has("auto_source")
	)' "$DEVICES_FILE" >/dev/null 2>&1; then
		migrate_lock="${DEVICES_FILE}.migrate.lock"
		migrate_wait=0
		while ! mkdir "$migrate_lock" 2>/dev/null; do
			if jq -e 'all(.[];
				has("backup_node_id") and has("failure_mode") and has("auto_source")
			)' "$DEVICES_FILE" >/dev/null 2>&1; then
				return 0
			fi
			[ "$migrate_wait" -lt 10 ] || json_error "Device state migration is busy"
			sleep 1
			migrate_wait=$((migrate_wait + 1))
		done
		# Re-check after taking the lock because another request may have
		# completed the migration while this process was waiting.
		if jq -e 'all(.[];
			has("backup_node_id") and has("failure_mode") and has("auto_source")
		)' "$DEVICES_FILE" >/dev/null 2>&1; then
			rmdir "$migrate_lock"
			return 0
		fi
		migrate_file="${DEVICES_FILE}.migrate.$$"
		jq 'map(. + {
			backup_node_id:(.backup_node_id // ""),
			failure_mode:(.failure_mode // "block"),
			auto_source:(.auto_source // "all")
		})' "$DEVICES_FILE" > "$migrate_file"
		mv "$migrate_file" "$DEVICES_FILE"
		rmdir "$migrate_lock"
	fi
}

physical_interfaces() {
	net_class_root="${PROXYOS_NET_CLASS_ROOT:-/sys/class/net}"
	for net_path in "$net_class_root"/*; do
		[ -e "$net_path" ] || continue
		iface="${net_path##*/}"
		case "$iface" in
			lo|br-*|docker*|veth*|tun*|tap*|wg*|proxyos*) continue ;;
		esac
		[ "$(cat "${net_path}/type" 2>/dev/null || true)" = "1" ] || continue
		[ -e "${net_path}/device" ] || continue
		[ ! -e "${net_path}/phy80211" ] || continue
		[ ! -d "${net_path}/wireless" ] || continue
		device_path="$(readlink -f "${net_path}/device" 2>/dev/null || printf '%s' "$iface")"
		printf '%s|%s\n' "$device_path" "$iface"
	done | sort | cut -d '|' -f 2
}

wifi_status() {
	available=false
	enabled=false
	phy_name=""
	driver=""
	reason="No AP-capable wireless adapter detected"
	ieee80211_root="${PROXYOS_IEEE80211_ROOT:-/sys/class/ieee80211}"
	iw_command="${PROXYOS_IW:-iw}"
	ubus_command="${PROXYOS_UBUS:-ubus}"

	for phy_path in "$ieee80211_root"/*; do
		[ -e "$phy_path" ] || continue
		candidate="${phy_path##*/}"
		if "$iw_command" phy "$candidate" info 2>/dev/null | grep -qE '^[[:space:]]+\*[[:space:]]+AP([[:space:]]|$)'; then
			available=true
			phy_name="$candidate"
			driver="$(basename "$(readlink -f "${phy_path}/device/driver" 2>/dev/null || true)")"
			reason=""
			break
		fi
	done

	if [ "$available" = true ]; then
		if "$ubus_command" call network.wireless status 2>/dev/null | jq -e 'to_entries | any(.value.up == true)' >/dev/null 2>&1; then
			enabled=true
		fi
	fi

	jq -n \
		--argjson available "$available" \
		--argjson enabled "$enabled" \
		--arg phy "$phy_name" \
		--arg driver "$driver" \
		--arg reason "$reason" \
		'{available:$available,enabled:$enabled,phy:$phy,driver:$driver,reason:$reason}'
}

status() {
	system_info="$(ubus call system info 2>/dev/null || printf '{}')"
	board_info="$(ubus call system board 2>/dev/null || printf '{}')"
	version="$(proxyos_version)"
	node_count="$(jq 'length' "$NODES_FILE")"
	bound_count="$(jq '[.[] | select(.policy == "fixed_node" or .policy == "auto_node")] | length' "$DEVICES_FILE")"
	singbox_running=false
	if ubus call service list '{"name":"proxyos"}' 2>/dev/null | jq -e '.. | objects | select(.running? == true)' >/dev/null 2>&1; then
		singbox_running=true
	fi

	jq -n \
		--argjson system "$system_info" \
		--argjson board "$board_info" \
		--arg version "$version" \
		--argjson nodes "$node_count" \
		--argjson bound "$bound_count" \
		--argjson running "$singbox_running" \
		'{
			version:$version,
			hostname:($board.hostname // "ProxyOS"),
			model:($board.model // "x86-64"),
			kernel:($board.kernel // ""),
			uptime:($system.uptime // 0),
			load:($system.load // [0,0,0]),
			memory:($system.memory // {}),
			node_count:$nodes,
			bound_device_count:$bound,
			singbox_running:$running
		}'
}

devices() {
	tmp_discovered="/tmp/proxyos-devices.$$.jsonl"
	tmp_result="/tmp/proxyos-devices.$$.json"
	lan_device="$(ubus call network.interface.lan status 2>/dev/null |
		jq -r '.l3_device // .device // "br-lan"' 2>/dev/null || printf 'br-lan')"
	: > "$tmp_discovered"

	if [ -r /tmp/dhcp.leases ]; then
		while read -r _expires mac ip hostname _clientid; do
			[ -n "${mac:-}" ] && [ -n "${ip:-}" ] || continue
			[ "${hostname:-*}" = "*" ] && hostname="Unknown device"
			jq -nc \
				--arg mac "$(printf '%s' "$mac" | tr 'a-f' 'A-F')" \
				--arg ip "$ip" \
				--arg name "$hostname" \
				'{mac:$mac,ip:$ip,name:$name,online:false,lease_registered:true}' >> "$tmp_discovered"
		done < /tmp/dhcp.leases
	fi

	for hostapd_object in $(ubus list 'hostapd.*' 2>/dev/null || true); do
		wireless_iface="${hostapd_object#hostapd.}"
		channel="$(iwinfo "$wireless_iface" info 2>/dev/null | sed -n 's/.*Channel: \([0-9][0-9]*\).*/\1/p' | head -n 1)"
		band="Wi-Fi"
		[ -z "$channel" ] || {
			if [ "$channel" -le 14 ]; then band="Wi-Fi 2.4GHz"; else band="Wi-Fi 5GHz"; fi
		}
		ubus call "$hostapd_object" get_clients 2>/dev/null |
			jq -c --arg band "$band" '
				(.clients // {}) | to_entries[] |
				{
					mac:(.key | ascii_upcase),
					connection:"wifi",
					band:$band,
					signal:(.value.signal // null),
					online:true
				}
			' >> "$tmp_discovered" || true
	done

	ip neigh show dev "$lan_device" 2>/dev/null |
	awk '
		/lladdr/ && ($NF == "REACHABLE" || $NF == "DELAY" || $NF == "PROBE" || $NF == "PERMANENT") {
			for (i = 1; i <= NF; i++) {
				if ($i == "lladdr" && (i + 1) <= NF) {
					print $1, $(i + 1)
					break
				}
			}
		}
	' |
	while read -r ip mac; do
		[ -n "${mac:-}" ] || continue
		case "$ip" in *:*) continue ;; esac
		jq -nc \
			--arg mac "$(printf '%s' "$mac" | tr 'a-f' 'A-F')" \
			--arg ip "$ip" \
			'{mac:$mac,ip:$ip,online:true}' >> "$tmp_discovered"
	done

	if [ -s "$tmp_discovered" ]; then
		jq -s '
			group_by(.mac) |
			map(reduce .[] as $item ({}; . * $item))
		' "$tmp_discovered" > "$tmp_result"
	else
		printf '[]\n' > "$tmp_result"
	fi

	jq -n --slurpfile discovered "$tmp_result" --slurpfile saved "$DEVICES_FILE" '{
		items: (
			($saved[0] // [] | map(. + {online:false})) as $configured |
			reduce ($discovered[0] // [])[] as $live
				($configured;
					if any(.[]; .mac == $live.mac) then
						map(if .mac == $live.mac then . * $live else . end)
					else . + [{name:"Unknown device"} + $live + {policy:"system_default",node_id:""}]
					end
				) |
			sort_by([(.online | not), .name])
		)
	}'

	rm -f "$tmp_discovered" "$tmp_result"
}

nodes() {
	jq '{
		items: map({
			id,
			name,
			protocol:(.outbound.type // "unknown"),
			source_type,
			source_id:(.source_id // ""),
			server:(.outbound.server // ""),
			server_port:(.outbound.server_port // 0),
			enabled:(.enabled // true),
			latency_ms:(.latency_ms // null),
			latency_domestic_ms:(.latency_domestic_ms // null),
			latency_foreign_ms:(.latency_foreign_ms // null),
			download_mbps:(.download_mbps // null),
			packet_loss_percent:(.packet_loss_percent // null),
			stability_score:(.stability_score // null),
			status:(.status // "unknown"),
			last_test:(.last_test // 0)
		})
	}' "$NODES_FILE"
}

node_get() {
	input="$1"
	node_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	[ -n "$node_id" ] || json_error "Node id is required"
	jq -e --arg id "$node_id" '
		.[] | select(.id == $id) |
		{
			id,
			name,
			source_type,
			source_id:(.source_id // ""),
			outbound_json:(.outbound | tojson)
		}
	' "$NODES_FILE" 2>/dev/null || json_error "Node not found"
}

check_proxy_outbound() {
	outbound_json="$1"
	test_config="/tmp/proxyos-outbound-check.$$.json"
	test_log="/tmp/proxyos-outbound-check.$$.log"
	PROXYOS_VALIDATION_ERROR=""
	jq -n --argjson outbound "$outbound_json" '{
		log:{level:"error"},
		inbounds:[{type:"mixed",tag:"validation-in",listen:"127.0.0.1",listen_port:20808}],
		outbounds:[($outbound + {tag:"validation-node"}),{type:"direct",tag:"direct"}],
		route:{rules:[],final:"validation-node"}
	}' > "$test_config"
	if ! "$SINGBOX" check -c "$test_config" >"$test_log" 2>&1; then
		PROXYOS_VALIDATION_ERROR="$(tail -n 1 "$test_log" 2>/dev/null || printf 'invalid outbound')"
		rm -f "$test_config" "$test_log"
		return 1
	fi
	rm -f "$test_config" "$test_log"
	return 0
}

validate_proxy_outbound() {
	if [ "${PROXYOS_SKIP_CONFIG_CHECK:-0}" = "1" ]; then
		return 0
	fi
	if ! check_proxy_outbound "$1"; then
		json_error "Invalid node configuration: ${PROXYOS_VALIDATION_ERROR}"
	fi
}

node_add() {
	input="$1"
	name="$(printf '%s' "$input" | jq -r '.name // empty')"
	outbound_json="$(printf '%s' "$input" | jq -r '.outbound_json // empty')"
	[ -n "$name" ] || json_error "Node name is required"
	printf '%s' "$outbound_json" | jq -e 'type == "object" and (.type | type == "string")' >/dev/null 2>&1 ||
		json_error "outbound_json must be a valid sing-box outbound object"

	outbound_type="$(printf '%s' "$outbound_json" | jq -r '.type')"
	case "$outbound_type" in
		direct|block|selector|urltest|"") json_error "This outbound type cannot be added as a proxy node" ;;
	esac

	canonical="$(printf '%s' "$outbound_json" | jq -Sc 'del(.tag)')"
	validate_proxy_outbound "$canonical"
	node_id="$(printf 'manual|%s' "$canonical" | sha256sum | cut -c 1-16)"
	node_json="$(jq -n \
		--arg id "$node_id" \
		--arg name "$name" \
		--argjson outbound "$canonical" \
		'{id:$id,name:$name,source_type:"manual",source_id:"",enabled:true,outbound:$outbound}')"

	nodes_rollback="${NODES_FILE}.rollback.$$"
	cp "$NODES_FILE" "$nodes_rollback"
	tmp_file="${NODES_FILE}.tmp.$$"
	jq --arg id "$node_id" --argjson node "$node_json" \
		'map(select(.id != $id)) + [$node]' "$NODES_FILE" > "$tmp_file"
	mv "$tmp_file" "$NODES_FILE"
	if ! apply_generated_config_raw; then
		mv "$nodes_rollback" "$NODES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$nodes_rollback"
	json_ok "\"id\":\"${node_id}\""
}

node_update() {
	input="$1"
	node_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	name="$(printf '%s' "$input" | jq -r '.name // empty')"
	outbound_json="$(printf '%s' "$input" | jq -r '.outbound_json // empty')"
	[ -n "$node_id" ] && [ -n "$name" ] || json_error "Node id and name are required"
	jq -e --arg id "$node_id" 'any(.[]; .id == $id)' "$NODES_FILE" >/dev/null ||
		json_error "Node not found"
	printf '%s' "$outbound_json" | jq -e '
		type == "object" and
		(.type | type == "string") and
		(.type | IN("direct","block","selector","urltest") | not)
	' >/dev/null 2>&1 || json_error "outbound_json must be a valid proxy outbound object"
	canonical="$(printf '%s' "$outbound_json" | jq -Sc 'del(.tag)')"
	validate_proxy_outbound "$canonical"
	nodes_rollback="${NODES_FILE}.rollback.$$"
	cp "$NODES_FILE" "$nodes_rollback"
	tmp_file="${NODES_FILE}.tmp.$$"
	jq --arg id "$node_id" --arg name "$name" --argjson outbound "$canonical" '
		map(if .id == $id then
			.name=$name |
			.outbound=$outbound |
			.status="unknown" |
			.latency_ms=null |
			.latency_domestic_ms=null |
			.latency_foreign_ms=null |
			.download_mbps=null |
			.packet_loss_percent=null |
			.stability_score=null
		else . end)
	' "$NODES_FILE" > "$tmp_file"
	mv "$tmp_file" "$NODES_FILE"
	if ! apply_generated_config_raw; then
		mv "$nodes_rollback" "$NODES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$nodes_rollback"
	json_ok
}

node_delete() {
	input="$1"
	node_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	[ -n "$node_id" ] || json_error "Node id is required"
	nodes_rollback="${NODES_FILE}.rollback.$$"
	devices_rollback="${DEVICES_FILE}.rollback.$$"
	cp "$NODES_FILE" "$nodes_rollback"
	cp "$DEVICES_FILE" "$devices_rollback"
	tmp_file="${NODES_FILE}.tmp.$$"
	jq --arg id "$node_id" 'map(select(.id != $id))' "$NODES_FILE" > "$tmp_file"
	mv "$tmp_file" "$NODES_FILE"
	tmp_file="${DEVICES_FILE}.tmp.$$"
	jq --arg id "$node_id" \
		'map(
			if .node_id == $id then
				.policy="block" | .node_id="" |
				if .backup_node_id == $id then .backup_node_id="" else . end
			elif .backup_node_id == $id then
				.backup_node_id="" | .failure_mode="block"
			else . end
		)' \
		"$DEVICES_FILE" > "$tmp_file"
	mv "$tmp_file" "$DEVICES_FILE"
	if ! apply_generated_config_raw; then
		mv "$nodes_rollback" "$NODES_FILE"
		mv "$devices_rollback" "$DEVICES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$nodes_rollback" "$devices_rollback"
	json_ok
}

probe_node() {
	node_id="$1"
	server="$(jq -r --arg id "$node_id" '.[] | select(.id == $id) | .outbound.server // empty' "$NODES_FILE")"
	server_port="$(jq -r --arg id "$node_id" '.[] | select(.id == $id) | .outbound.server_port // empty' "$NODES_FILE")"
	[ -n "$server" ] && [ -n "$server_port" ] || {
		printf 'error|null\n'
		return 0
	}

	connect_time="$(
		curl --silent --show-error --output /dev/null \
			--connect-timeout 4 --max-time 5 \
			--connect-to "proxyos.test:80:${server}:${server_port}" \
			--write-out '%{time_connect}' \
			http://proxyos.test/ 2>/dev/null || true
	)"
	case "$connect_time" in
		""|0|0.0|0.00|0.000|0.0000|0.00000|0.000000)
			status="error"
			latency="null"
			;;
		*)
			status="available"
			latency="$(awk "BEGIN { printf \"%d\", (${connect_time} * 1000) }")"
			;;
	esac
	printf '%s|%s\n' "$status" "$latency"
}

fetch_public_ip() {
	proxy_url="${1:-}"
	for endpoint in \
		"https://api.ip.sb/ip" \
		"https://icanhazip.com" \
		"https://api.ipify.org"; do
		if [ -n "$proxy_url" ]; then
			probe_response="$(
				curl -4 --fail --silent --show-error --location \
					--proxy "$proxy_url" \
					--connect-timeout 3 --max-time 8 \
					--write-out '\n%{time_total}' \
					"$endpoint" 2>/dev/null || true
			)"
		else
			probe_response="$(
				curl -4 --fail --silent --show-error --location \
					--connect-timeout 3 --max-time 8 \
					--write-out '\n%{time_total}' \
					"$endpoint" 2>/dev/null || true
			)"
		fi
		probe_ip="$(printf '%s\n' "$probe_response" | sed '$d' | tr -d '\r\n[:space:]')"
		probe_time="$(printf '%s\n' "$probe_response" | tail -n 1)"
		if printf '%s' "$probe_ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
			printf '%s|%s\n' "$probe_ip" "$probe_time"
			return 0
		fi
	done
	return 1
}

probe_proxy_latency() {
	proxy_url="$1"
	endpoint="$2"
	max_time="${3:-10}"
	probe_time="$(
		curl -4 --fail --silent --show-error --location \
			--output /dev/null \
			--proxy "$proxy_url" \
			--connect-timeout 4 --max-time "$max_time" \
			--write-out '%{time_starttransfer}' \
			"$endpoint" 2>/dev/null || true
	)"
	case "$probe_time" in
		""|0|0.0|0.00|0.000|0.0000|0.00000|0.000000)
			printf 'null\n'
			;;
		*)
			awk "BEGIN { printf \"%d\\n\", (${probe_time} * 1000) }"
			;;
	esac
}

probe_proxy_download_speed() {
	proxy_url="$1"
	speed_bytes="$(
		curl -4 --fail --silent --show-error --location \
			--output /dev/null \
			--proxy "$proxy_url" \
			--connect-timeout 5 --max-time 25 \
			--write-out '%{speed_download}' \
			"https://speed.cloudflare.com/__down?bytes=4000000" 2>/dev/null || true
	)"
	case "$speed_bytes" in
		""|0|0.0|0.00|0.000|0.0000)
			printf 'null\n'
			;;
		*)
			awk "BEGIN {
				speed = (${speed_bytes} * 8) / 1000000;
				if (speed > 0) printf \"%.1f\\n\", speed; else print \"null\";
			}"
			;;
	esac
}

probe_proxy_quality() {
	proxy_url="$1"
	attempts=5
	successes=0
	samples=""
	probe_index=0
	while [ "$probe_index" -lt "$attempts" ]; do
		sample="$(probe_proxy_latency "$proxy_url" "https://www.gstatic.com/generate_204" 5)"
		if [ "$sample" != "null" ]; then
			successes=$((successes + 1))
			samples="${samples} ${sample}"
		fi
		probe_index=$((probe_index + 1))
	done
	packet_loss=$(((attempts - successes) * 100 / attempts))
	if [ "$successes" -eq 0 ]; then
		printf '%s|0\n' "$packet_loss"
		return 0
	fi
	stability="$(
		printf '%s\n' "$samples" | awk -v successes="$successes" -v attempts="$attempts" '
			{
				for (i = 1; i <= NF; i++) {
					value[i] = $i
					sum += $i
				}
			}
			END {
				mean = sum / successes
				variance = 0
				for (i = 1; i <= successes; i++) {
					delta = value[i] - mean
					variance += delta * delta
				}
				jitter = sqrt(variance / successes)
				jitter_penalty = jitter / 5
				if (jitter_penalty > 25) jitter_penalty = 25
				score = (successes / attempts * 100) - jitter_penalty
				if (score < 0) score = 0
				if (score > 100) score = 100
				printf "%d\n", score + 0.5
			}
		'
	)"
	printf '%s|%s\n' "$packet_loss" "$stability"
}

probe_node_egress() {
	node_id="$1"
	probe_mode="${2:-quick}"
	outbound="$(jq -c --arg id "$node_id" '.[] | select(.id == $id) | .outbound' "$NODES_FILE")"
	[ -n "$outbound" ] || {
		printf 'error|null|null|null|null|null|null\n'
		return 0
	}
	test_port=$((20000 + ($$ % 20000)))
	test_config="/tmp/proxyos-node-test.$$.json"
	test_log="/tmp/proxyos-node-test.$$.log"
	jq -n --argjson outbound "$outbound" --argjson port "$test_port" '{
		log:{level:"error"},
		inbounds:[{type:"mixed",tag:"test-in",listen:"127.0.0.1",listen_port:$port}],
		outbounds:[
			($outbound + {tag:"test-node",domain_resolver:"dns-direct"}),
			{type:"direct",tag:"direct"}
		],
		dns:{
			servers:[{type:"local",tag:"dns-direct"}],
			final:"dns-direct",
			strategy:"ipv4_only"
		},
		route:{
			default_domain_resolver:"dns-direct",
			rules:[],
			final:"test-node"
		}
	}' > "$test_config"
	if ! "$SINGBOX" check -c "$test_config" >"$test_log" 2>&1; then
		rm -f "$test_config" "$test_log"
		printf 'error|null|null|null|null|null|null\n'
		return 0
	fi
	"$SINGBOX" run -c "$test_config" >"$test_log" 2>&1 &
	test_pid="$!"
	sleep 1
	proxy_url="socks5h://127.0.0.1:${test_port}"
	latency_domestic_file="/tmp/proxyos-latency-domestic.$$.txt"
	latency_foreign_file="/tmp/proxyos-latency-foreign.$$.txt"
	probe_proxy_latency "$proxy_url" "https://www.baidu.com/favicon.ico" > "$latency_domestic_file" &
	latency_domestic_pid="$!"
	probe_proxy_latency "$proxy_url" "https://www.gstatic.com/generate_204" > "$latency_foreign_file" &
	latency_foreign_pid="$!"
	wait "$latency_domestic_pid" 2>/dev/null || true
	wait "$latency_foreign_pid" 2>/dev/null || true
	latency_domestic="$(cat "$latency_domestic_file" 2>/dev/null || printf 'null')"
	latency_foreign="$(cat "$latency_foreign_file" 2>/dev/null || printf 'null')"
	download_mbps="null"
	packet_loss_percent="null"
	stability_score="null"
	if [ "$probe_mode" = "full" ] &&
		{ [ "$latency_domestic" != "null" ] || [ "$latency_foreign" != "null" ]; }; then
		quality_result="$(probe_proxy_quality "$proxy_url")"
		packet_loss_percent="$(printf '%s' "$quality_result" | cut -d '|' -f 1)"
		stability_score="$(printf '%s' "$quality_result" | cut -d '|' -f 2)"
		download_mbps="$(probe_proxy_download_speed "$proxy_url")"
	fi
	kill "$test_pid" >/dev/null 2>&1 || true
	wait "$test_pid" 2>/dev/null || true
	rm -f "$test_config" "$test_log" "$latency_domestic_file" "$latency_foreign_file"
	if [ "$latency_foreign" != "null" ]; then
		latency="$latency_foreign"
	elif [ "$latency_domestic" != "null" ]; then
		latency="$latency_domestic"
	else
		printf 'error|null|null|null|null|null|null\n'
		return 0
	fi
	printf 'available|%s|%s|%s|%s|%s|%s\n' \
		"$latency" "$latency_domestic" "$latency_foreign" \
		"$download_mbps" "$packet_loss_percent" "$stability_score"
}

save_probe() {
	node_id="$1"
	status="$2"
	latency="$3"
	latency_domestic="$4"
	latency_foreign="$5"
	download_mbps="${6:-null}"
	packet_loss_percent="${7:-null}"
	stability_score="${8:-null}"
	now="$(date +%s)"
	tmp_file="${NODES_FILE}.tmp.$$"
	jq --arg id "$node_id" --arg status "$status" \
		--argjson latency "$latency" \
		--argjson latency_domestic "$latency_domestic" \
		--argjson latency_foreign "$latency_foreign" \
		--argjson download_mbps "$download_mbps" \
		--argjson packet_loss_percent "$packet_loss_percent" \
		--argjson stability_score "$stability_score" \
		--argjson now "$now" '
		map(if .id == $id then
			.status=$status |
			.latency_ms=$latency |
			.latency_domestic_ms=$latency_domestic |
			.latency_foreign_ms=$latency_foreign |
			.download_mbps=(if $download_mbps == null then (.download_mbps // null) else $download_mbps end) |
			.packet_loss_percent=(if $packet_loss_percent == null then (.packet_loss_percent // null) else $packet_loss_percent end) |
			.stability_score=(if $stability_score == null then (.stability_score // null) else $stability_score end) |
			.last_test=$now
		else . end)
	' "$NODES_FILE" > "$tmp_file"
	mv "$tmp_file" "$NODES_FILE"
}

node_test() {
	input="$1"
	node_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	[ -n "$node_id" ] || json_error "Node id is required"
	jq -e --arg id "$node_id" 'any(.[]; .id == $id)' "$NODES_FILE" >/dev/null ||
		json_error "Node not found"
	old_status="$(jq -r --arg id "$node_id" '.[] | select(.id == $id) | .status // "unknown"' "$NODES_FILE")"
	nodes_rollback="${NODES_FILE}.rollback.$$"
	cp "$NODES_FILE" "$nodes_rollback"
	result="$(probe_node_egress "$node_id" full)"
	status="$(printf '%s' "$result" | cut -d '|' -f 1)"
	latency="$(printf '%s' "$result" | cut -d '|' -f 2)"
	latency_domestic="$(printf '%s' "$result" | cut -d '|' -f 3)"
	latency_foreign="$(printf '%s' "$result" | cut -d '|' -f 4)"
	download_mbps="$(printf '%s' "$result" | cut -d '|' -f 5)"
	packet_loss_percent="$(printf '%s' "$result" | cut -d '|' -f 6)"
	stability_score="$(printf '%s' "$result" | cut -d '|' -f 7)"
	save_probe "$node_id" "$status" "$latency" "$latency_domestic" "$latency_foreign" \
		"$download_mbps" "$packet_loss_percent" "$stability_score"
	if [ "$status" != "$old_status" ] && ! apply_generated_config_raw; then
		mv "$nodes_rollback" "$NODES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$nodes_rollback"

	if [ "$status" = "available" ]; then
		jq -n \
			--argjson latency "$latency" \
			--argjson latency_domestic "$latency_domestic" \
			--argjson latency_foreign "$latency_foreign" \
			--argjson download_mbps "$download_mbps" \
			--argjson packet_loss_percent "$packet_loss_percent" \
			--argjson stability_score "$stability_score" \
			'{
				ok:true,
				status:"available",
				latency_ms:$latency,
				latency_domestic_ms:$latency_domestic,
				latency_foreign_ms:$latency_foreign,
				download_mbps:$download_mbps,
				packet_loss_percent:$packet_loss_percent,
				stability_score:$stability_score
			}'
	else
		jq -n '{
			ok:false,
			error:"Baidu and Google latency checks both failed",
			status:"error",
			latency_ms:null,
			latency_domestic_ms:null,
			latency_foreign_ms:null,
			download_mbps:null,
			packet_loss_percent:100,
			stability_score:0
		}'
	fi
}

health_check() {
	changed=false
	health_snapshot="/tmp/proxyos-health-snapshot.$$.json"
	health_updates="/tmp/proxyos-health-updates.$$.jsonl"
	health_cursor_file="/tmp/proxyos-health.cursor"
	health_batch_size="${PROXYOS_HEALTH_BATCH_SIZE:-$(uci -q get proxyos.main.health_batch_size || printf '4')}"
	case "$health_batch_size" in
		''|*[!0-9]*) health_batch_size=4 ;;
	esac
	[ "$health_batch_size" -gt 0 ] || health_batch_size=4
	cp "$NODES_FILE" "$health_snapshot"
	: > "$health_updates"
	health_node_count="$(jq 'length' "$health_snapshot")"
	if [ "$health_node_count" -eq 0 ]; then
		rm -f "$health_snapshot" "$health_updates" "$health_cursor_file"
		json_ok '"tested":0'
	fi
	health_cursor="$(cat "$health_cursor_file" 2>/dev/null || printf '0')"
	printf '%s' "$health_cursor" | grep -Eq '^[0-9]+$' || health_cursor=0
	health_cursor=$((health_cursor % health_node_count))
	health_tested=0
	while [ "$health_tested" -lt "$health_batch_size" ] && [ "$health_tested" -lt "$health_node_count" ]; do
		health_index=$(((health_cursor + health_tested) % health_node_count))
		node_id="$(jq -r --argjson index "$health_index" '.[$index].id' "$health_snapshot")"
		old_status="$(jq -r --arg id "$node_id" '.[] | select(.id == $id) | .status // "unknown"' "$health_snapshot")"
		result="$(probe_node_egress "$node_id")"
		new_status="$(printf '%s' "$result" | cut -d '|' -f 1)"
		latency="$(printf '%s' "$result" | cut -d '|' -f 2)"
		latency_domestic="$(printf '%s' "$result" | cut -d '|' -f 3)"
		latency_foreign="$(printf '%s' "$result" | cut -d '|' -f 4)"
		now="$(date +%s)"
		jq -nc --arg id "$node_id" --arg status "$new_status" \
			--argjson latency "$latency" \
			--argjson latency_domestic "$latency_domestic" \
			--argjson latency_foreign "$latency_foreign" \
			--argjson now "$now" \
			'{
				id:$id,
				status:$status,
				latency_ms:$latency,
				latency_domestic_ms:$latency_domestic,
				latency_foreign_ms:$latency_foreign,
				last_test:$now
			}' >> "$health_updates"
		[ "$new_status" = "$old_status" ] || changed=true
		health_tested=$((health_tested + 1))
	done
	printf '%s\n' "$(((health_cursor + health_tested) % health_node_count))" > "$health_cursor_file"
	acquire_mutation_lock
	assert_state_writable
	health_rollback="${NODES_FILE}.rollback.$$"
	cp "$NODES_FILE" "$health_rollback"
	health_tmp="${NODES_FILE}.health.$$"
	jq --slurpfile updates "$health_updates" '
		($updates | INDEX(.id)) as $by_id |
		map(
			if $by_id[.id] then
				.status=$by_id[.id].status |
				.latency_ms=$by_id[.id].latency_ms |
				.latency_domestic_ms=$by_id[.id].latency_domestic_ms |
				.latency_foreign_ms=$by_id[.id].latency_foreign_ms |
				.last_test=$by_id[.id].last_test
			else . end
		)
	' "$NODES_FILE" > "$health_tmp"
	mv "$health_tmp" "$NODES_FILE"
	rm -f "$health_snapshot" "$health_updates"
	if [ "$changed" = true ]; then
		if ! apply_generated_config_raw; then
			mv "$health_rollback" "$NODES_FILE"
			json_error "$APPLY_ERROR"
		fi
	fi
	rm -f "$health_rollback"
	json_ok "\"tested\":${health_tested},\"total\":${health_node_count}"
}

egress_check() {
	input="$1"
	node_id="$(printf '%s' "$input" | jq -r '.node_id // empty')"
	device_mac="$(printf '%s' "$input" | jq -r '.device_mac // empty' | tr 'a-f' 'A-F')"
	test_config="/tmp/proxyos-egress-test.$$.json"
	test_log="/tmp/proxyos-egress-test.$$.log"
	test_port=$((20000 + ($$ % 20000)))
	test_pid=""
	mode="direct"
	if [ -n "$device_mac" ]; then
		device="$(jq -c --arg mac "$device_mac" '.[] | select(.mac == $mac)' "$DEVICES_FILE" | head -n 1)"
		[ -n "$device" ] || device='{"policy":"system_default","failure_mode":"block","backup_node_id":"","auto_source":"all"}'
		policy="$(printf '%s' "$device" | jq -r '.policy // "system_default"')"
		if [ "$policy" = "system_default" ]; then
			policy="$(uci -q get proxyos.main.default_policy || printf 'direct')"
			node_id="$(uci -q get proxyos.main.default_node_id || true)"
		elif [ "$policy" = "fixed_node" ]; then
			node_id="$(printf '%s' "$device" | jq -r '.node_id // empty')"
		elif [ "$policy" = "auto_node" ]; then
			auto_source="$(printf '%s' "$device" | jq -r '.auto_source // "all"')"
			node_id="$(jq -r --arg source "$auto_source" '
				[
					.[] |
					select(
						(.enabled // true) and
						(.status // "unknown") != "error" and
						($source == "all" or .source_type == $source)
					)
				] |
				sort_by(if .latency_ms == null then 999999 else .latency_ms end) |
				.[0].id // ""
			' "$NODES_FILE")"
		fi

		if [ "$policy" = "block" ]; then
			jq -n --arg mac "$device_mac" '{ok:true,blocked:true,device_mac:$mac,mode:"block"}'
			return 0
		fi
		if [ "$policy" = "fixed_node" ] || [ "$policy" = "auto_node" ]; then
			if ! jq -e --arg id "$node_id" '
				any(.[]; .id == $id and (.enabled // true) and (.status // "unknown") != "error")
			' "$NODES_FILE" >/dev/null 2>&1; then
				failure_mode="$(printf '%s' "$device" | jq -r '.failure_mode // "block"')"
				backup_node_id="$(printf '%s' "$device" | jq -r '.backup_node_id // empty')"
				if [ "$failure_mode" = "backup" ] &&
					jq -e --arg id "$backup_node_id" '
						any(.[]; .id == $id and (.enabled // true) and (.status // "unknown") != "error")
					' "$NODES_FILE" >/dev/null 2>&1; then
					node_id="$backup_node_id"
				elif [ "$failure_mode" = "direct" ]; then
					node_id=""
				else
					jq -n --arg mac "$device_mac" '{ok:true,blocked:true,device_mac:$mac,mode:"fail-closed"}'
					return 0
				fi
			fi
		else
			node_id=""
		fi
	fi
	if [ -n "$node_id" ]; then
		outbound="$(jq -c --arg id "$node_id" '.[] | select(.id == $id) | .outbound' "$NODES_FILE")"
		[ -n "$outbound" ] || json_error "Selected node does not exist"
		jq -n --argjson outbound "$outbound" --argjson port "$test_port" '{
			log:{level:"warn"},
			inbounds:[{type:"mixed",tag:"test-in",listen:"127.0.0.1",listen_port:$port}],
			outbounds:[($outbound + {tag:"test-node"}),{type:"direct",tag:"direct"}],
			route:{rules:[],final:"test-node"}
		}' > "$test_config"
		"$SINGBOX" check -c "$test_config" >/dev/null 2>"$test_log" ||
			json_error "The selected node configuration is invalid"
		"$SINGBOX" run -c "$test_config" >"$test_log" 2>&1 &
		test_pid="$!"
		sleep 1
		mode="node"
	fi
	if [ -n "$test_pid" ]; then
		public_result="$(fetch_public_ip "socks5h://127.0.0.1:${test_port}" || true)"
		kill "$test_pid" >/dev/null 2>&1 || true
		wait "$test_pid" 2>/dev/null || true
	else
		public_result="$(fetch_public_ip "" || true)"
	fi
	rm -f "$test_config" "$test_log"
	public_ip="${public_result%%|*}"
	printf '%s' "$public_ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' ||
		json_error "Public exit IP request failed"
	jq -n --arg ip "$public_ip" --arg mode "$mode" --arg node_id "$node_id" --arg mac "$device_mac" \
		'{ok:true,ip:$ip,mode:$mode,node_id:$node_id,device_mac:$mac,blocked:false}'
}

device_bind() {
	input="$1"
	mac="$(printf '%s' "$input" | jq -r '.mac // empty' | tr 'a-f' 'A-F')"
	ip="$(printf '%s' "$input" | jq -r '.ip // empty')"
	name="$(printf '%s' "$input" | jq -r '.name // "Unknown device"')"
	policy="$(printf '%s' "$input" | jq -r '.policy // "system_default"')"
	node_id="$(printf '%s' "$input" | jq -r '.node_id // ""')"
	backup_node_id="$(printf '%s' "$input" | jq -r '.backup_node_id // ""')"
	failure_mode="$(printf '%s' "$input" | jq -r '.failure_mode // "block"')"
	auto_source="$(printf '%s' "$input" | jq -r '.auto_source // "all"')"

	printf '%s' "$mac" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || json_error "Invalid MAC address"
	printf '%s' "$ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || json_error "Invalid IPv4 address"
	case "$policy" in
		system_default|fixed_node|auto_node|direct|block) ;;
		*) json_error "Invalid device policy" ;;
	esac
	case "$failure_mode" in block|backup|direct) ;; *) json_error "Invalid node failure mode" ;; esac
	case "$auto_source" in all|manual|subscription) ;; *) json_error "Invalid automatic-node source" ;; esac
	if [ "$policy" = "fixed_node" ]; then
		jq -e --arg id "$node_id" 'any(.[]; .id == $id)' "$NODES_FILE" >/dev/null ||
			json_error "Selected node does not exist"
		probe_result="$(probe_node_egress "$node_id")"
		probe_status="$(printf '%s' "$probe_result" | cut -d '|' -f 1)"
		probe_latency="$(printf '%s' "$probe_result" | cut -d '|' -f 2)"
		probe_latency_domestic="$(printf '%s' "$probe_result" | cut -d '|' -f 3)"
		probe_latency_foreign="$(printf '%s' "$probe_result" | cut -d '|' -f 4)"
		save_probe "$node_id" "$probe_status" "$probe_latency" "$probe_latency_domestic" "$probe_latency_foreign"
		[ "$probe_status" = "available" ] ||
			json_error "所选节点无法建立真实代理出口，设备策略未更改"
	fi
	if [ -n "$backup_node_id" ]; then
		jq -e --arg id "$backup_node_id" 'any(.[]; .id == $id)' "$NODES_FILE" >/dev/null ||
			json_error "Selected backup node does not exist"
	fi

	device_json="$(jq -n \
		--arg mac "$mac" --arg ip "$ip" --arg name "$name" \
		--arg policy "$policy" --arg node_id "$node_id" \
		--arg backup "$backup_node_id" --arg failure "$failure_mode" --arg source "$auto_source" \
		'{
			mac:$mac,
			ip:$ip,
			name:$name,
			policy:$policy,
			node_id:$node_id,
			backup_node_id:$backup,
			failure_mode:$failure,
			auto_source:$source
		}')"
	devices_rollback="${DEVICES_FILE}.rollback.$$"
	cp "$DEVICES_FILE" "$devices_rollback" ||
		json_error "无法创建设备策略回滚文件，请检查系统存储"
	tmp_file="${DEVICES_FILE}.tmp.$$"
	jq --arg mac "$mac" --argjson device "$device_json" \
		'map(select(.mac != $mac)) + [$device]' "$DEVICES_FILE" > "$tmp_file" ||
		json_error "无法生成设备策略，请检查系统存储"
	mv "$tmp_file" "$DEVICES_FILE" ||
		json_error "无法保存设备策略，请检查启动盘或 Overlay 文件系统"
	if ! apply_generated_config_raw; then
		mv "$devices_rollback" "$DEVICES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$devices_rollback"

	if [ "${PROXYOS_SKIP_DHCP:-0}" != "1" ]; then
		existing_section="$(uci show dhcp 2>/dev/null |
			sed -n "s/^\(dhcp\.[^.]*\)\.mac='${mac}'$/\1/p" | head -n 1)"
		if [ -z "$existing_section" ]; then
			existing_section="dhcp.$(uci add dhcp host)"
		fi
		uci set "${existing_section}.name=${name}"
		uci set "${existing_section}.mac=${mac}"
		uci set "${existing_section}.ip=${ip}"
		uci commit dhcp
		/etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	fi

	json_ok
}

devices_assign_node() {
	input="$1"
	node_id="$(printf '%s' "$input" | jq -r '.node_id // empty')"
	device_macs="$(printf '%s' "$input" | jq -c '
		[.device_macs[]? | ascii_upcase] | unique
	')"
	[ -n "$node_id" ] || json_error "Node id is required"
	jq -e --arg id "$node_id" 'any(.[]; .id == $id)' "$NODES_FILE" >/dev/null ||
		json_error "Selected node does not exist"
	printf '%s' "$device_macs" | jq -e 'type == "array" and length > 0' >/dev/null ||
		json_error "Select at least one valid device"
	for selected_mac in $(printf '%s' "$device_macs" | jq -r '.[]'); do
		printf '%s' "$selected_mac" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' ||
			json_error "Select at least one valid device"
	done
	missing_count="$(jq -n \
		--argjson selected "$device_macs" \
		--slurpfile devices "$DEVICES_FILE" '
			($devices[0] | map(.mac)) as $known |
			[$selected[] as $mac | select(($known | index($mac)) == null) | $mac] |
			length
	')"
	[ "$missing_count" -eq 0 ] || json_error "One or more selected devices no longer exist"

	probe_result="$(probe_node_egress "$node_id")"
	probe_status="$(printf '%s' "$probe_result" | cut -d '|' -f 1)"
	probe_latency="$(printf '%s' "$probe_result" | cut -d '|' -f 2)"
	probe_latency_domestic="$(printf '%s' "$probe_result" | cut -d '|' -f 3)"
	probe_latency_foreign="$(printf '%s' "$probe_result" | cut -d '|' -f 4)"
	save_probe "$node_id" "$probe_status" "$probe_latency" "$probe_latency_domestic" "$probe_latency_foreign"
	[ "$probe_status" = "available" ] ||
		json_error "所选节点无法建立真实代理出口，设备策略未更改"

	devices_rollback="${DEVICES_FILE}.rollback.$$"
	cp "$DEVICES_FILE" "$devices_rollback" ||
		json_error "无法创建设备策略回滚文件，请检查系统存储"
	tmp_file="${DEVICES_FILE}.tmp.$$"
	jq --arg id "$node_id" --argjson selected "$device_macs" '
		map(
			. as $device |
			if ($selected | index($device.mac)) != null then
				.policy="fixed_node" |
				.node_id=$id |
				.backup_node_id=(.backup_node_id // "") |
				.failure_mode=(.failure_mode // "block") |
				.auto_source=(.auto_source // "all")
			else . end
		)
	' "$DEVICES_FILE" > "$tmp_file" ||
		json_error "无法生成批量设备策略，请检查系统存储"
	mv "$tmp_file" "$DEVICES_FILE" ||
		json_error "无法保存批量设备策略，请检查启动盘或 Overlay 文件系统"
	if ! apply_generated_config_raw; then
		mv "$devices_rollback" "$DEVICES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$devices_rollback"
	assigned_count="$(printf '%s' "$device_macs" | jq 'length')"
	jq -n --argjson assigned_count "$assigned_count" \
		'{ok:true,assigned_count:$assigned_count}'
}

generate_config() {
	tmp_base="/tmp/proxyos-config-base.$$.json"
	tmp_rules="/tmp/proxyos-config-rules.$$.json"
	candidate_path="${ACTIVE_CONFIG}.candidate.$$"
	default_node="$(uci -q get proxyos.main.default_node_id || true)"
	default_policy="$(uci -q get proxyos.main.default_policy || printf 'direct')"

	jq -n --slurpfile template "$TEMPLATE_FILE" --slurpfile nodes "$NODES_FILE" '
		($template[0]) as $base |
		($nodes[0] // []) as $nodes |
		$base |
		# A node hostname must be resolved before that node can carry traffic.
		# Pin bootstrap resolution to the direct DNS server so per-device DNS
		# routing cannot recursively send the lookup through the same node.
		.outbounds = (
			($nodes | map(
				.outbound + {
					tag:("node-" + .id),
					domain_resolver:"dns-direct"
				}
			)) +
			[{type:"direct",tag:"direct"}]
		) |
		.dns.servers = (
			[
				{
					type:"local",
					tag:"dns-direct"
				}
			] +
			($nodes | map({
				type:"https",
				tag:("dns-node-" + .id),
				server:"1.1.1.1",
				path:"/dns-query",
				tls:{enabled:true,server_name:"cloudflare-dns.com"},
				detour:("node-" + .id)
			}))
		)
	' > "$tmp_base"

	jq -n --slurpfile devices "$DEVICES_FILE" --slurpfile nodes "$NODES_FILE" '
		($nodes[0] // []) as $node_list |
		def usable($id):
			any($node_list[]; .id == $id and (.enabled // true) and (.status // "unknown") != "error");
		def fallback($device):
			if ($device.failure_mode // "block") == "backup" and
				($device.backup_node_id // "") != "" and usable($device.backup_node_id)
			then $device.backup_node_id
			elif ($device.failure_mode // "block") == "direct"
			then "__direct__"
			else "__block__"
			end;
		def automatic($device):
			[
				$node_list[] |
				select(
					(.enabled // true) and
					(.status // "unknown") != "error" and
					(
						($device.auto_source // "all") == "all" or
						.source_type == ($device.auto_source // "all")
					)
				)
			] |
			sort_by(if .latency_ms == null then 999999 else .latency_ms end) |
			(.[0].id // "");
		def resolve($device):
			if $device.policy == "block" then "__block__"
			elif $device.policy == "direct" then "__direct__"
			elif $device.policy == "fixed_node" then
				if usable($device.node_id) then $device.node_id else fallback($device) end
			elif $device.policy == "auto_node" then
				(automatic($device)) as $auto |
				if $auto != "" then $auto else fallback($device) end
			else ""
			end;
		[
			($devices[0] // [])[] |
			select((.ip // "") != "") |
			. + {effective_outbound:resolve(.)}
		] as $resolved |
		{
			block:[
				$resolved[] |
				select(.effective_outbound == "__block__") |
				{source_ip_cidr:[(.ip + "/32")],action:"reject",method:"drop"}
			],
			route:[
				$resolved[] |
				select(.effective_outbound != "" and .effective_outbound != "__block__") |
				{
					source_ip_cidr:[(.ip + "/32")],
					action:"route",
					outbound:(
						if .effective_outbound == "__direct__"
						then "direct"
						else "node-" + .effective_outbound
						end
					)
				}
			],
			dns:[
				$resolved[] |
				select(.effective_outbound != "__block__") |
				{
					source_ip_cidr:[(.ip + "/32")],
					action:"route",
					server:(
						if .effective_outbound == "" or .effective_outbound == "__direct__"
						then "dns-direct"
						else "dns-node-" + .effective_outbound
						end
					)
				}
			]
		}
	' > "$tmp_rules"

	final_outbound="direct"
	default_block=false
	if [ "$default_policy" = "fixed_node" ] &&
		jq -e --arg id "$default_node" 'any(.[]; .id == $id and (.status // "unknown") != "error")' "$NODES_FILE" >/dev/null 2>&1; then
		final_outbound="node-${default_node}"
	elif [ "$default_policy" = "fixed_node" ] || [ "$default_policy" = "block" ]; then
		default_block=true
	fi

	jq --slurpfile device_rules "$tmp_rules" --arg final "$final_outbound" --argjson default_block "$default_block" '
		.route.rules = (
			[
				{action:"sniff"}
			] +
			($device_rules[0].block // []) +
			[
				{protocol:"dns",action:"hijack-dns"},
				{ip_is_private:true,action:"route",outbound:"direct"}
			] +
			($device_rules[0].route // []) +
			(if $default_block then [{action:"reject",method:"drop"}] else [] end)
		) |
		.route.final = $final |
		.dns.rules = ($device_rules[0].dns // [])
	' "$tmp_base" > "$candidate_path"

	rm -f "$tmp_base" "$tmp_rules"
	printf '%s\n' "$candidate_path"
}

restart_proxy_service() {
	restart_log="/tmp/proxyos-restart.$$.log"
	/etc/init.d/proxyos restart >"$restart_log" 2>&1 &
	restart_pid="$!"
	restart_wait=0
	while kill -0 "$restart_pid" >/dev/null 2>&1; do
		if [ "$restart_wait" -ge 20 ]; then
			kill "$restart_pid" >/dev/null 2>&1 || true
			wait "$restart_pid" 2>/dev/null || true
			logger -t proxyos "Proxy restart timed out"
			rm -f "$restart_log"
			return 1
		fi
		sleep 1
		restart_wait=$((restart_wait + 1))
	done
	if ! wait "$restart_pid"; then
		logger -t proxyos "Proxy restart failed: $(tail -n 1 "$restart_log" 2>/dev/null || true)"
		rm -f "$restart_log"
		return 1
	fi
	rm -f "$restart_log"
	return 0
}

apply_generated_config_raw() {
	APPLY_ERROR=""
	candidate="$(generate_config)"
	check_log="/tmp/proxyos-singbox-check.$$.log"
	if [ "${PROXYOS_SKIP_CONFIG_CHECK:-0}" != "1" ] &&
		! "$SINGBOX" check -c "$candidate" >"$check_log" 2>&1; then
		check_error="$(tail -n 1 "$check_log" 2>/dev/null || true)"
		rm -f "$candidate"
		rm -f "$check_log"
		APPLY_ERROR="sing-box rejected the generated configuration: ${check_error}"
		return 1
	fi
	rm -f "$check_log"

	[ ! -s "$ACTIVE_CONFIG" ] || cp "$ACTIVE_CONFIG" "$LAST_GOOD_CONFIG"
	mv "$candidate" "$ACTIVE_CONFIG"
	if [ "${PROXYOS_SKIP_RESTART:-0}" = "1" ]; then
		return 0
	fi
	restart_proxy_service || {
		if [ -s "$LAST_GOOD_CONFIG" ]; then
			cp "$LAST_GOOD_CONFIG" "$ACTIVE_CONFIG"
			restart_proxy_service || true
		fi
		APPLY_ERROR="Proxy restart failed; previous configuration was restored"
		return 1
	}
	return 0
}

apply_generated_config() {
	if ! apply_generated_config_raw; then
		json_error "$APPLY_ERROR"
	fi
}

wifi_toggle() {
	input="$1"
	requested="$(printf '%s' "$input" | jq -r '.enabled // empty')"
	current_status="$(wifi_status)"
	printf '%s' "$current_status" | jq -e '.available == true' >/dev/null ||
		json_error "Wi-Fi is unavailable because no AP-capable adapter was detected"
	case "$requested" in
		true) wifi up ;;
		false) wifi down ;;
		*) json_error "enabled must be true or false" ;;
	esac
	json_ok
}

wireless_radio_for_band() {
	requested_band="$1"
	for radio in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band="$(uci -q get "wireless.${radio}.band" || true)"
		case "${requested_band}:${band}" in
			2g:2g|2g:2.4g|5g:5g|6g:6g) printf '%s\n' "$radio"; return 0 ;;
		esac
	done
	return 1
}

wireless_iface_for_radio() {
	radio="$1"
	uci show wireless 2>/dev/null |
		sed -n "s/^wireless\.\([^.]*\)\.device='${radio}'$/\1/p" |
		head -n 1
}

wifi_config() {
	status_json="$(wifi_status)"
	tmp_bands="/tmp/proxyos-wifi-bands.$$.jsonl"
	: > "$tmp_bands"
	for radio in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band="$(uci -q get "wireless.${radio}.band" || printf 'unknown')"
		channel="$(uci -q get "wireless.${radio}.channel" || printf 'auto')"
		htmode="$(uci -q get "wireless.${radio}.htmode" || true)"
		country="$(uci -q get "wireless.${radio}.country" || printf 'CN')"
		txpower="$(uci -q get "wireless.${radio}.txpower" || true)"
		radio_disabled="$(uci -q get "wireless.${radio}.disabled" || printf '0')"
		iface="$(wireless_iface_for_radio "$radio" || true)"
		ssid="$(uci -q get "wireless.${iface}.ssid" || true)"
		encryption="$(uci -q get "wireless.${iface}.encryption" || true)"
		iface_disabled="$(uci -q get "wireless.${iface}.disabled" || printf '0')"
		enabled=true
		[ "$radio_disabled" = "1" ] && enabled=false
		[ "$iface_disabled" = "1" ] && enabled=false
		jq -nc \
			--arg radio "$radio" --arg iface "$iface" --arg band "$band" \
			--arg ssid "$ssid" --arg encryption "$encryption" --arg channel "$channel" \
			--arg htmode "$htmode" --arg country "$country" --arg txpower "$txpower" \
			--argjson enabled "$enabled" \
			'{
				radio:$radio,
				iface:$iface,
				band:$band,
				ssid:$ssid,
				encryption:$encryption,
				channel:$channel,
				htmode:$htmode,
				country:$country,
				txpower:($txpower | tonumber? // null),
				enabled:$enabled
			}' >> "$tmp_bands"
	done
	bands="$(jq -s '.' "$tmp_bands")"
	guest_disabled="$(uci -q get wireless.proxyos_guest.disabled || printf '1')"
	guest_enabled=false
	[ "$guest_disabled" = "0" ] && guest_enabled=true
	guest_ssid="$(uci -q get wireless.proxyos_guest.ssid || printf 'ProxyOS-Guest')"
	rm -f "$tmp_bands"
	jq -n --argjson status "$status_json" --argjson bands "$bands" \
		--argjson guest "$guest_enabled" --arg guest_ssid "$guest_ssid" \
		'$status + {bands:$bands,guest_enabled:$guest,guest_ssid:$guest_ssid}'
}

ensure_wireless_iface() {
	radio="$1"
	band="$2"
	iface="$(wireless_iface_for_radio "$radio" || true)"
	if [ -z "$iface" ]; then
		iface="proxyos_${band}"
		uci set "wireless.${iface}=wifi-iface"
		uci set "wireless.${iface}.device=${radio}"
		uci set "wireless.${iface}.mode=ap"
		uci set "wireless.${iface}.network=lan"
	fi
	printf '%s\n' "$iface"
}

wifi_apply() {
	input="$1"
	status_json="$(wifi_status)"
	printf '%s' "$status_json" | jq -e '.available == true' >/dev/null ||
		json_error "Wi-Fi is unavailable because no AP-capable adapter was detected"
	ssid_24="$(printf '%s' "$input" | jq -r '.ssid_24 // "ProxyOS-2.4G"')"
	ssid_5="$(printf '%s' "$input" | jq -r '.ssid_5 // "ProxyOS-5G"')"
	password="$(printf '%s' "$input" | jq -r '.password // empty')"
	country="$(printf '%s' "$input" | jq -r '.country // "CN"')"
	encryption="$(printf '%s' "$input" | jq -r '.encryption // "sae-mixed"')"
	txpower="$(printf '%s' "$input" | jq -r '.txpower // empty')"
	channel_24="$(printf '%s' "$input" | jq -r '.channel_24 // "auto"')"
	channel_5="$(printf '%s' "$input" | jq -r '.channel_5 // "auto"')"
	htmode_24="$(printf '%s' "$input" | jq -r '.htmode_24 // "HE40"')"
	htmode_5="$(printf '%s' "$input" | jq -r '.htmode_5 // "HE80"')"
	guest_enabled="$(printf '%s' "$input" | jq -r '.guest_enabled // false')"
	printf '%s' "$ssid_24$ssid_5" | grep -q '[[:cntrl:]]' && json_error "SSID contains invalid characters"
	if [ -n "$password" ]; then
		[ "${#password}" -ge 8 ] && [ "${#password}" -le 63 ] ||
			json_error "Wi-Fi password must contain 8 to 63 characters"
	fi
	printf '%s' "$country" | grep -Eq '^[A-Z]{2}$' || json_error "Invalid Wi-Fi country code"
	case "$encryption" in psk2|sae|sae-mixed) ;; *) json_error "Unsupported Wi-Fi security mode" ;; esac

	for requested_band in 2g 5g; do
		radio="$(wireless_radio_for_band "$requested_band" || true)"
		[ -n "$radio" ] || continue
		iface="$(ensure_wireless_iface "$radio" "$requested_band")"
		existing_key="$(uci -q get "wireless.${iface}.key" || true)"
		[ -n "$password" ] || password="$existing_key"
		[ -n "$password" ] || json_error "A Wi-Fi password is required for a new access point"
		if [ "$requested_band" = "2g" ]; then
			ssid="$ssid_24"; channel="$channel_24"; htmode="$htmode_24"
		else
			ssid="$ssid_5"; channel="$channel_5"; htmode="$htmode_5"
		fi
		uci set "wireless.${radio}.country=${country}"
		uci set "wireless.${radio}.channel=${channel}"
		uci set "wireless.${radio}.htmode=${htmode}"
		uci set "wireless.${radio}.disabled=0"
		[ -z "$txpower" ] || uci set "wireless.${radio}.txpower=${txpower}"
		uci set "wireless.${iface}.mode=ap"
		uci set "wireless.${iface}.network=lan"
		uci set "wireless.${iface}.ssid=${ssid}"
		uci set "wireless.${iface}.encryption=${encryption}"
		uci set "wireless.${iface}.key=${password}"
		uci set "wireless.${iface}.disabled=0"
	done

	guest_radio="$(wireless_radio_for_band 5g || wireless_radio_for_band 2g || true)"
	if [ "$guest_enabled" = "true" ]; then
		[ -n "$guest_radio" ] || json_error "No radio is available for the guest network"
		uci set network.br_guest='device'
		uci set network.br_guest.name='br-guest'
		uci set network.br_guest.type='bridge'
		uci set network.guest='interface'
		uci set network.guest.device='br-guest'
		uci set network.guest.proto='static'
		uci set network.guest.ipaddr='192.168.30.1'
		uci set network.guest.netmask='255.255.255.0'
		uci set dhcp.guest='dhcp'
		uci set dhcp.guest.interface='guest'
		uci set dhcp.guest.start='100'
		uci set dhcp.guest.limit='150'
		uci set dhcp.guest.leasetime='4h'
		uci set firewall.proxyos_guest='zone'
		uci set firewall.proxyos_guest.name='guest'
		uci set firewall.proxyos_guest.network='guest'
		uci set firewall.proxyos_guest.input='REJECT'
		uci set firewall.proxyos_guest.output='ACCEPT'
		uci set firewall.proxyos_guest.forward='REJECT'
		uci set firewall.proxyos_guest_wan='forwarding'
		uci set firewall.proxyos_guest_wan.src='guest'
		uci set firewall.proxyos_guest_wan.dest='wan'
		uci set firewall.proxyos_guest_dns='rule'
		uci set firewall.proxyos_guest_dns.name='Allow-Guest-DNS'
		uci set firewall.proxyos_guest_dns.src='guest'
		uci set firewall.proxyos_guest_dns.dest_port='53'
		uci set firewall.proxyos_guest_dns.proto='tcp udp'
		uci set firewall.proxyos_guest_dns.target='ACCEPT'
		uci set firewall.proxyos_guest_dhcp='rule'
		uci set firewall.proxyos_guest_dhcp.name='Allow-Guest-DHCP'
		uci set firewall.proxyos_guest_dhcp.src='guest'
		uci set firewall.proxyos_guest_dhcp.dest_port='67'
		uci set firewall.proxyos_guest_dhcp.proto='udp'
		uci set firewall.proxyos_guest_dhcp.family='ipv4'
		uci set firewall.proxyos_guest_dhcp.target='ACCEPT'
		uci set wireless.proxyos_guest='wifi-iface'
		uci set "wireless.proxyos_guest.device=${guest_radio}"
		uci set wireless.proxyos_guest.mode='ap'
		uci set wireless.proxyos_guest.network='guest'
		uci set "wireless.proxyos_guest.ssid=${ssid_5}-Guest"
		uci set "wireless.proxyos_guest.encryption=${encryption}"
		uci set "wireless.proxyos_guest.key=${password}"
		uci set wireless.proxyos_guest.isolate='1'
		uci set wireless.proxyos_guest.disabled='0'
	else
		uci -q set wireless.proxyos_guest.disabled='1' || true
	fi
	uci commit network
	uci commit dhcp
	uci commit firewall
	uci commit wireless
	/etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	wifi reload >/dev/null 2>&1 || json_error "Wireless reload failed"
	json_ok
}

wifi_disconnect() {
	input="$1"
	mac="$(printf '%s' "$input" | jq -r '.mac // empty' | tr 'a-f' 'A-F')"
	printf '%s' "$mac" | grep -Eq '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || json_error "Invalid MAC address"
	disconnected=false
	for hostapd_object in $(ubus list 'hostapd.*' 2>/dev/null); do
		if ubus call "$hostapd_object" del_client "{\"addr\":\"${mac}\",\"reason\":5,\"deauth\":true,\"ban_time\":60000}" >/dev/null 2>&1; then
			disconnected=true
		fi
	done
	[ "$disconnected" = true ] || json_error "Wireless client is not connected"
	json_ok
}

ports() {
	wan_device="$(uci -q get network.wan.device || true)"
	lan_ports="$(uci -q get network.br_lan.ports || true)"
	if [ -z "$lan_ports" ] && [ -d /sys/class/net/br-lan/brif ]; then
		for lan_member in /sys/class/net/br-lan/brif/*; do
			[ -e "$lan_member" ] || continue
			lan_ports="${lan_ports} ${lan_member##*/}"
		done
	fi
	tmp_ports="/tmp/proxyos-ports.$$.jsonl"
	: > "$tmp_ports"
	for iface in $(physical_interfaces); do
		mac="$(cat "/sys/class/net/${iface}/address" 2>/dev/null || true)"
		state="$(cat "/sys/class/net/${iface}/operstate" 2>/dev/null || printf 'unknown')"
		speed="$(cat "/sys/class/net/${iface}/speed" 2>/dev/null || printf '0')"
		driver="$(basename "$(readlink -f "/sys/class/net/${iface}/device/driver" 2>/dev/null || true)")"
		role="unused"
		[ "$iface" = "$wan_device" ] && role="wan"
		printf ' %s ' "$lan_ports" | grep -q " ${iface} " && role="lan"
		jq -nc \
			--arg name "$iface" --arg mac "$mac" --arg state "$state" \
			--arg speed "$speed" --arg driver "$driver" --arg role "$role" \
			'{name:$name,mac:$mac,state:$state,speed_mbps:($speed|tonumber? // 0),driver:$driver,role:$role}' \
			>> "$tmp_ports"
	done
	jq -s '{items:.}' "$tmp_ports"
	rm -f "$tmp_ports"
}

ports_apply() {
	input="$1"
	assignments="$(printf '%s' "$input" | jq -r '.assignments_json // empty')"
	printf '%s' "$assignments" | jq -e 'type == "array"' >/dev/null 2>&1 ||
		json_error "assignments_json must be an array"
	[ "$(printf '%s' "$assignments" | jq '[.[] | select(.role == "wan")] | length')" = "1" ] ||
		json_error "Exactly one WAN port is required"
	[ "$(printf '%s' "$assignments" | jq '[.[] | select(.role == "lan")] | length')" -ge 1 ] ||
		json_error "At least one LAN port is required"

	for iface in $(printf '%s' "$assignments" | jq -r '.[].name'); do
		case "$iface" in *[!A-Za-z0-9_.:-]*) json_error "Invalid interface name" ;; esac
		[ -e "/sys/class/net/${iface}/device" ] || json_error "Interface ${iface} is not a physical port"
	done

	cp /etc/config/network "$PORT_ROLLBACK_CONFIG"
	touch "$PORT_ROLLBACK_FLAG"
	wan_iface="$(printf '%s' "$assignments" | jq -r '.[] | select(.role == "wan") | .name')"

	uci -q batch <<-EOF
		set network.wan='interface'
		set network.wan.proto='dhcp'
		set network.wan.device='${wan_iface}'
		set network.br_lan='device'
		set network.br_lan.name='br-lan'
		set network.br_lan.type='bridge'
		delete network.br_lan.ports
		set network.lan='interface'
		set network.lan.device='br-lan'
		set network.lan.proto='static'
		set network.lan.ipaddr='192.168.10.1'
		set network.lan.netmask='255.255.255.0'
	EOF
	for iface in $(printf '%s' "$assignments" | jq -r '.[] | select(.role == "lan") | .name'); do
		uci add_list "network.br_lan.ports=${iface}"
	done
	uci commit network

	nohup sh -c '
		sleep 90
		if [ -f /tmp/proxyos-port-rollback.pending ]; then
			cp /tmp/proxyos-network.rollback /etc/config/network
			rm -f /tmp/proxyos-port-rollback.pending
			/etc/init.d/network restart
			logger -t proxyos "Port assignment rolled back because it was not confirmed"
		fi
	' >/dev/null 2>&1 &
	/etc/init.d/network restart >/dev/null 2>&1 &
	json_ok "\"confirmation_timeout\":90"
}

ports_confirm() {
	rm -f "$PORT_ROLLBACK_FLAG" "$PORT_ROLLBACK_CONFIG"
	json_ok
}

subscription_add() {
	input="$1"
	name="$(printf '%s' "$input" | jq -r '.name // empty')"
	url="$(printf '%s' "$input" | jq -r '.url // empty')"
	[ -n "$name" ] && [ -n "$url" ] || json_error "Subscription name and URL are required"
	sub_id="$(printf '%s|%s' "$name" "$url" | sha256sum | cut -c 1-16)"
	sub_json="$(jq -n --arg id "$sub_id" --arg name "$name" --arg url "$url" \
		'{id:$id,name:$name,url:$url,format:"auto",node_count:0,skipped_count:0,last_update:0,status:"new",error:"",warning:""}')"
	tmp_file="${SUBSCRIPTIONS_FILE}.tmp.$$"
	jq --arg id "$sub_id" --argjson sub "$sub_json" \
		'map(select(.id != $id)) + [$sub]' "$SUBSCRIPTIONS_FILE" > "$tmp_file"
	mv "$tmp_file" "$SUBSCRIPTIONS_FILE"
	json_ok "\"id\":\"${sub_id}\""
}

subscriptions() {
	jq '{items: map(del(.url) + {url_configured:(.url | length > 0)})}' "$SUBSCRIPTIONS_FILE"
}

subscription_get() {
	input="$1"
	sub_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	[ -n "$sub_id" ] || json_error "Subscription id is required"
	jq -e --arg id "$sub_id" '
		.[] | select(.id == $id) |
		. + {
			skipped_count:(.skipped_count // 0),
			warning:(.warning // ""),
			error:(.error // "")
		}
	' "$SUBSCRIPTIONS_FILE" 2>/dev/null || json_error "Subscription not found"
}

subscription_save() {
	input="$1"
	sub_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	name="$(printf '%s' "$input" | jq -r '.name // empty')"
	url="$(printf '%s' "$input" | jq -r '.url // empty')"
	[ -n "$sub_id" ] && [ -n "$name" ] && [ -n "$url" ] ||
		json_error "Subscription id, name, and URL are required"
	case "$url" in
		http://*|https://*) ;;
		*) json_error "Subscription URL must use HTTP or HTTPS" ;;
	esac
	jq -e --arg id "$sub_id" 'any(.[]; .id == $id)' "$SUBSCRIPTIONS_FILE" >/dev/null ||
		json_error "Subscription not found"
	save_tmp="${SUBSCRIPTIONS_FILE}.tmp.$$"
	jq --arg id "$sub_id" --arg name "$name" --arg url "$url" '
		map(if .id == $id then
			.name=$name |
			.url=$url
		else . end)
	' "$SUBSCRIPTIONS_FILE" > "$save_tmp" ||
		json_error "Subscription settings could not be prepared"
	mv "$save_tmp" "$SUBSCRIPTIONS_FILE" ||
		json_error "Subscription settings could not be saved"
	json_ok "\"id\":\"${sub_id}\""
}

subscription_mark_error() {
	sub_id="$1"
	message="$2"
	error_tmp="${SUBSCRIPTIONS_FILE}.error.$$"
	jq --arg id "$sub_id" --arg message "$message" \
		'map(if .id == $id then .status="error" | .error=$message else . end)' \
		"$SUBSCRIPTIONS_FILE" > "$error_tmp"
	mv "$error_tmp" "$SUBSCRIPTIONS_FILE"
}

subscription_delete() {
	input="$1"
	sub_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	[ -n "$sub_id" ] || json_error "Subscription id is required"
	jq -e --arg id "$sub_id" 'any(.[]; .id == $id)' "$SUBSCRIPTIONS_FILE" >/dev/null ||
		json_error "Subscription not found"
	subscriptions_rollback="${SUBSCRIPTIONS_FILE}.rollback.$$"
	nodes_rollback="${NODES_FILE}.rollback.$$"
	cp "$SUBSCRIPTIONS_FILE" "$subscriptions_rollback"
	cp "$NODES_FILE" "$nodes_rollback"
	subscriptions_tmp="${SUBSCRIPTIONS_FILE}.tmp.$$"
	nodes_tmp="${NODES_FILE}.tmp.$$"
	jq --arg id "$sub_id" 'map(select(.id != $id))' "$SUBSCRIPTIONS_FILE" > "$subscriptions_tmp"
	mv "$subscriptions_tmp" "$SUBSCRIPTIONS_FILE"
	jq --arg id "$sub_id" 'map(select(.source_id != $id))' "$NODES_FILE" > "$nodes_tmp"
	mv "$nodes_tmp" "$NODES_FILE"
	if ! apply_generated_config_raw; then
		mv "$subscriptions_rollback" "$SUBSCRIPTIONS_FILE"
		mv "$nodes_rollback" "$NODES_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$subscriptions_rollback" "$nodes_rollback"
	json_ok
}

subscription_update() {
	input="$1"
	sub_id="$(printf '%s' "$input" | jq -r '.id // empty')"
	url="$(jq -r --arg id "$sub_id" '.[] | select(.id == $id) | .url' "$SUBSCRIPTIONS_FILE")"
	[ -n "$url" ] || json_error "Subscription not found"
	download="/tmp/proxyos-subscription.$$.txt"
	parsed="/tmp/proxyos-subscription.$$.parsed.json"
	download_error="/tmp/proxyos-subscription.$$.download-error"
	if ! curl --fail --location --compressed --connect-timeout 8 --max-time 30 \
		--retry 1 --retry-delay 1 \
		--user-agent "Clash.Meta/ProxyOS" \
		--header "Accept: application/json, text/yaml, text/plain, */*" \
		"$url" -o "$download" 2>"$download_error"; then
		error_text="$(tail -n 1 "$download_error" 2>/dev/null || printf 'network request failed')"
		subscription_mark_error "$sub_id" "Download failed: ${error_text}"
		rm -f "$download" "$download_error"
		json_error "Subscription download failed: ${error_text}"
	fi
	rm -f "$download_error"
	[ -r "$PARSER" ] || json_error "Subscription parser is not installed"
	parser_error="/tmp/proxyos-subscription.$$.error"
	if ! "$PYTHON" "$PARSER" --subscription-id "$sub_id" --input "$download" --output "$parsed" 2>"$parser_error"; then
		error_text="$(cat "$parser_error" 2>/dev/null || printf 'Subscription parse failed')"
		[ -n "$error_text" ] || error_text="Subscription parser failed without an error message"
		subscription_mark_error "$sub_id" "$error_text"
		rm -f "$download" "$parsed" "$parser_error"
		json_error "$error_text"
	fi
	format="$(jq -r '.format' "$parsed")"
	candidate_count="$(jq '.nodes | length' "$parsed")"
	parser_skipped_count="$(jq '.skipped // [] | length' "$parsed")"
	parsed_count=$((candidate_count + parser_skipped_count))

	# Validate every outbound independently. Real-world subscriptions often
	# contain one stale, provider-specific, or malformed entry among many good
	# nodes. A single bad record must not make the whole subscription unusable.
	valid_nodes="/tmp/proxyos-subscription.$$.valid-nodes.json"
	skipped_nodes="/tmp/proxyos-subscription.$$.skipped-nodes.json"
	printf '[]\n' > "$valid_nodes"
	jq '.skipped // []' "$parsed" > "$skipped_nodes"
	node_index=0
	while [ "$node_index" -lt "$candidate_count" ]; do
		node_json="$(jq -c ".nodes[${node_index}]" "$parsed")"
		outbound_json="$(printf '%s' "$node_json" | jq -c '.outbound')"
		if [ "${PROXYOS_SKIP_CONFIG_CHECK:-0}" = "1" ] ||
			check_proxy_outbound "$outbound_json"; then
			valid_tmp="${valid_nodes}.tmp"
			jq --argjson node "$node_json" '. + [$node]' "$valid_nodes" > "$valid_tmp"
			mv "$valid_tmp" "$valid_nodes"
		else
			node_name="$(printf '%s' "$node_json" | jq -r '.name // "Unnamed node"')"
			skipped_tmp="${skipped_nodes}.tmp"
			jq --arg name "$node_name" --arg error "$PROXYOS_VALIDATION_ERROR" \
				'. + [{name:$name,error:$error}]' "$skipped_nodes" > "$skipped_tmp"
			mv "$skipped_tmp" "$skipped_nodes"
		fi
		node_index=$((node_index + 1))
	done

	node_count="$(jq 'length' "$valid_nodes")"
	skipped_count="$(jq 'length' "$skipped_nodes")"
	if [ "$node_count" -eq 0 ]; then
		error_text="$(jq -r '.[0].error // "No compatible nodes were found"' "$skipped_nodes")"
		subscription_mark_error "$sub_id" "$error_text"
		rm -f "$download" "$parsed" "$parser_error" "$valid_nodes" "$skipped_nodes"
		json_error "No compatible proxy nodes could be imported: ${error_text}"
	fi
	parsed_valid="${parsed}.valid"
	jq --slurpfile valid "$valid_nodes" --slurpfile skipped "$skipped_nodes" \
		'.nodes=$valid[0] | .skipped=$skipped[0]' "$parsed" > "$parsed_valid"
	mv "$parsed_valid" "$parsed"

	tmp_file="${NODES_FILE}.tmp.$$"
	jq -n --arg sub "$sub_id" --slurpfile old "$NODES_FILE" --slurpfile parsed "$parsed" '
		($old[0] // []) as $old_nodes |
		($parsed[0].nodes // [] |
			map(. as $fresh |
				($old_nodes | map(select(.id == $fresh.id)) | .[0]) as $previous |
				$fresh + {
					status:($previous.status // "unknown"),
					latency_ms:($previous.latency_ms // null),
					latency_domestic_ms:($previous.latency_domestic_ms // null),
					latency_foreign_ms:($previous.latency_foreign_ms // null),
					download_mbps:($previous.download_mbps // null),
					packet_loss_percent:($previous.packet_loss_percent // null),
					stability_score:($previous.stability_score // null),
					last_test:($previous.last_test // 0)
				}
			)
		) as $fresh_nodes |
		($old_nodes | map(select(.source_id != $sub))) + $fresh_nodes
	' > "$tmp_file"
	old_nodes_file="$NODES_FILE"
	NODES_FILE="$tmp_file"
	staged_config="$(generate_config)"
	NODES_FILE="$old_nodes_file"
	staged_log="/tmp/proxyos-subscription-check.$$.log"
	if [ "${PROXYOS_SKIP_CONFIG_CHECK:-0}" != "1" ] &&
		! "$SINGBOX" check -c "$staged_config" >"$staged_log" 2>&1; then
		error_text="$(tail -n 1 "$staged_log" 2>/dev/null || printf 'Generated sing-box configuration is invalid')"
		subscription_mark_error "$sub_id" "$error_text"
		rm -f "$download" "$parsed" "$parser_error" "$valid_nodes" "$skipped_nodes" "$tmp_file" "$staged_config" "$staged_log"
		json_error "Subscription contains an unsupported or invalid node: ${error_text}"
	fi
	rm -f "$staged_config" "$staged_log"
	nodes_rollback="${NODES_FILE}.rollback.$$"
	subscriptions_rollback="${SUBSCRIPTIONS_FILE}.rollback.$$"
	cp "$NODES_FILE" "$nodes_rollback"
	cp "$SUBSCRIPTIONS_FILE" "$subscriptions_rollback"
	mv "$tmp_file" "$NODES_FILE"
	now="$(date +%s)"
	warning=""
	if [ "$skipped_count" -gt 0 ]; then
		warning="Imported ${node_count} nodes and skipped ${skipped_count} incompatible nodes"
	fi
	tmp_file="${SUBSCRIPTIONS_FILE}.tmp.$$"
	jq --arg id "$sub_id" --argjson now "$now" --arg format "$format" \
		--argjson count "$node_count" --argjson skipped "$skipped_count" --arg warning "$warning" \
		'map(if .id == $id then
			.last_update=$now |
			.status="ok" |
			.error="" |
			.warning=$warning |
			.format=$format |
			.node_count=$count |
			.skipped_count=$skipped
		else . end)' \
		"$SUBSCRIPTIONS_FILE" > "$tmp_file"
	mv "$tmp_file" "$SUBSCRIPTIONS_FILE"
	rm -f "$download" "$parsed" "$parser_error" "$valid_nodes" "$skipped_nodes"
	if ! apply_generated_config_raw; then
		mv "$nodes_rollback" "$NODES_FILE"
		mv "$subscriptions_rollback" "$SUBSCRIPTIONS_FILE"
		json_error "$APPLY_ERROR"
	fi
	rm -f "$nodes_rollback" "$subscriptions_rollback"
	json_ok "\"format\":$(printf '%s' "$format" | jq -Rs .),\"node_count\":${node_count},\"skipped_count\":${skipped_count},\"detected_count\":${parsed_count}"
}

policy_settings() {
	default_policy="$(uci -q get proxyos.main.default_policy || printf 'direct')"
	default_node_id="$(uci -q get proxyos.main.default_node_id || true)"
	jq -n --arg policy "$default_policy" --arg node "$default_node_id" \
		'{default_policy:$policy,default_node_id:$node,health_interval:300,health_batch_size:4,fail_closed:true}'
}

policy_apply() {
	input="$1"
	default_policy="$(printf '%s' "$input" | jq -r '.default_policy // "direct"')"
	default_node_id="$(printf '%s' "$input" | jq -r '.default_node_id // ""')"
	case "$default_policy" in direct|fixed_node|block) ;; *) json_error "Invalid default policy" ;; esac
	if [ "$default_policy" = "fixed_node" ]; then
		jq -e --arg id "$default_node_id" 'any(.[]; .id == $id)' "$NODES_FILE" >/dev/null ||
			json_error "Default node does not exist"
	fi
	old_default_policy="$(uci -q get proxyos.main.default_policy || printf 'direct')"
	old_default_node_id="$(uci -q get proxyos.main.default_node_id || true)"
	uci set "proxyos.main.default_policy=${default_policy}"
	uci set "proxyos.main.default_node_id=${default_node_id}"
	uci commit proxyos
	if ! apply_generated_config_raw; then
		uci set "proxyos.main.default_policy=${old_default_policy}"
		uci set "proxyos.main.default_node_id=${old_default_node_id}"
		uci commit proxyos
		json_error "$APPLY_ERROR"
	fi
	json_ok
}

backup_create() {
	archive="/tmp/proxyos-backup.$$.tar.gz"
	files="etc/proxyos/nodes.json etc/proxyos/devices.json etc/proxyos/subscriptions.json etc/proxyos/config-template.json etc/config/proxyos etc/config/network etc/config/dhcp etc/config/wireless etc/config/firewall"
	(
		cd /
		existing=""
		for path in $files; do [ -e "$path" ] && existing="${existing} ${path}"; done
		# shellcheck disable=SC2086
		tar -czf "$archive" $existing
	) || json_error "Configuration backup could not be created"
	[ -s "$archive" ] || json_error "Configuration backup archive is empty"
	encoded="$(base64 < "$archive" | tr -d '\r\n')"
	rm -f "$archive"
	[ -n "$encoded" ] || json_error "Configuration backup encoding failed"
	jq -n --arg filename "ProxyOS-backup-$(date +%Y%m%d-%H%M%S).tar.gz" --arg data "$encoded" \
		'{ok:true,filename:$filename,data_base64:$data}'
}

backup_restore() {
	input="$1"
	encoded="$(printf '%s' "$input" | jq -r '.data_base64 // empty')"
	[ -n "$encoded" ] || json_error "Backup data is required"
	archive="/tmp/proxyos-restore.$$.tar.gz"
	restore_dir="/tmp/proxyos-restore.$$"
	rollback_dir="/tmp/proxyos-restore-rollback.$$"
	printf '%s' "$encoded" | base64 -d > "$archive" 2>/dev/null || json_error "Backup is not valid Base64"
	tar -tzf "$archive" > "${archive}.list" 2>/dev/null || json_error "Backup archive is invalid"
	if grep -Eq '(^/|(^|/)\.\.(/|$))' "${archive}.list"; then
		json_error "Backup archive contains unsafe paths"
	fi
	if grep -Ev '^(etc/proxyos(/|$)|etc/config/(proxyos|network|dhcp|wireless|firewall)$)' "${archive}.list" |
		grep -q .; then
		json_error "Backup archive contains unsupported files"
	fi
	mkdir -p "$restore_dir"
	tar -xzf "$archive" -C "$restore_dir"
	mkdir -p "${rollback_dir}/etc/config" "${rollback_dir}/etc/proxyos"
	for config_name in proxyos network dhcp wireless firewall; do
		[ ! -f "/etc/config/${config_name}" ] ||
			cp "/etc/config/${config_name}" "${rollback_dir}/etc/config/${config_name}"
	done
	for current_state in "$STATE_DIR"/*.json; do
		[ -f "$current_state" ] || continue
		cp "$current_state" "${rollback_dir}/etc/proxyos/"
	done
	for config_name in proxyos network dhcp wireless firewall; do
		[ ! -f "${restore_dir}/etc/config/${config_name}" ] ||
			cp "${restore_dir}/etc/config/${config_name}" "/etc/config/${config_name}"
	done
	if [ -d "${restore_dir}/etc/proxyos" ]; then
		for state_file in "${restore_dir}/etc/proxyos/"*.json; do
			[ -f "$state_file" ] || continue
			cp "$state_file" "$STATE_DIR/"
		done
	fi
	rm -rf "$restore_dir"
	rm -f "$archive" "${archive}.list"
	if ! apply_generated_config_raw; then
		for config_name in proxyos network dhcp wireless firewall; do
			[ ! -f "${rollback_dir}/etc/config/${config_name}" ] ||
				cp "${rollback_dir}/etc/config/${config_name}" "/etc/config/${config_name}"
		done
		rm -f "$STATE_DIR"/*.json
		for previous_state in "${rollback_dir}/etc/proxyos/"*.json; do
			[ -f "$previous_state" ] || continue
			cp "$previous_state" "$STATE_DIR/"
		done
		rm -rf "$rollback_dir"
		json_error "$APPLY_ERROR"
	fi
	rm -rf "$rollback_dir"
	json_ok "\"reboot_recommended\":true"
}

password_set() {
	input="$1"
	password="$(printf '%s' "$input" | jq -r '.password // empty')"
	[ "${#password}" -ge 8 ] || json_error "Administrator password must contain at least 8 characters"
	[ "${#password}" -le 128 ] || json_error "Administrator password is too long"
	printf '%s\n%s\n' "$password" "$password" | passwd root >/dev/null 2>&1 ||
		json_error "Administrator password could not be changed"
	json_ok
}

system_logs() {
	logs="$(logread -e proxyos 2>/dev/null | tail -n 120 || true)"
	jq -n --arg text "$logs" '{items:($text | split("\n") | map(select(length > 0)))}'
}

update_check() {
	current_version="$(proxyos_version)"
	release_api="$(uci -q get proxyos.main.release_api || printf 'https://api.github.com/repos/t2459666333-cloud/proxyos-alpha/releases/latest')"
	version_api="$(uci -q get proxyos.main.version_api || printf 'https://raw.githubusercontent.com/t2459666333-cloud/proxyos-alpha/main/VERSION')"
	release_file="/tmp/proxyos-release.$$.json"
	release_error="/tmp/proxyos-release.$$.error"
	if ! curl --fail --silent --show-error --location \
		--connect-timeout 5 --max-time 12 \
		--header "Accept: application/vnd.github+json" \
		--user-agent "ProxyOS/${current_version}" \
		"$release_api" -o "$release_file" 2>"$release_error"; then
		# A new installation may be built before the first GitHub Release is
		# published. Fall back to the repository VERSION file instead of
		# showing a permanent 404 error in the system page.
		if ! curl --fail --silent --show-error --location \
			--connect-timeout 5 --max-time 12 \
			--user-agent "ProxyOS/${current_version}" \
			"$version_api" -o "$release_file" 2>"$release_error"; then
			rm -f "$release_file" "$release_error"
			jq -n --arg current "$current_version" '{
				ok:true,
				current_version:$current,
				latest_version:$current,
				available:false,
				source_available:false,
				release_url:"",
				message:"当前没有可访问的公开更新源，系统仍可正常使用"
			}'
			return 0
		fi
	fi
	if jq -e 'type == "object"' "$release_file" >/dev/null 2>&1; then
		latest_version="$(jq -r '.tag_name // .version // empty' "$release_file" | sed 's/^v//')"
		release_url="$(jq -r '.html_url // .url // empty' "$release_file")"
	else
		latest_version="$(sed -n '1{s/[[:space:]]//g;s/^v//;p;}' "$release_file")"
		release_url="https://github.com/t2459666333-cloud/proxyos-alpha"
	fi
	rm -f "$release_file" "$release_error"
	printf '%s' "$latest_version" | grep -Eq '^[0-9][0-9A-Za-z.-]*$' ||
		json_error "Update service returned no valid version"
	available=false
	[ "$latest_version" = "$current_version" ] || available=true
	jq -n --arg current "$current_version" --arg latest "$latest_version" \
		--arg url "$release_url" --argjson available "$available" \
		'{ok:true,current_version:$current,latest_version:$latest,available:$available,source_available:true,release_url:$url}'
}

system_reboot() {
	json_ok
	(sleep 2; reboot) >/dev/null 2>&1 &
}

acquire_mutation_lock() {
	mutation_lock="/tmp/proxyos-mutation.lock"
	mutation_wait=0
	while ! mkdir "$mutation_lock" 2>/dev/null; do
		lock_pid="$(cat "${mutation_lock}/pid" 2>/dev/null || true)"
		if [ -z "$lock_pid" ] || ! kill -0 "$lock_pid" >/dev/null 2>&1; then
			rm -rf "$mutation_lock"
			continue
		fi
		[ "$mutation_wait" -lt 20 ] || json_error "另一项 ProxyOS 设置仍在应用，请稍后重试"
		sleep 1
		mutation_wait=$((mutation_wait + 1))
	done
	printf '%s\n' "$$" > "${mutation_lock}/pid"
	trap 'rm -rf /tmp/proxyos-mutation.lock' EXIT HUP INT TERM
}

assert_state_writable() {
	write_probe="${STATE_DIR}/.proxyos-write-test.$$"
	if ! (umask 077; printf '%s\n' "$$" > "$write_probe") 2>/dev/null; then
		json_error "系统存储无法写入，设备策略不会生效；请更换或重新写入启动盘"
	fi
	rm -f "$write_probe" ||
		json_error "系统存储写入检查失败，请检查启动盘或 Overlay 文件系统"
}

command_name="${1:-}"
input="${2-}"
[ -n "$input" ] || input='{}'

require_commands
ensure_state

case "$command_name" in
	node-add|node-update|node-delete|node-test|device-bind|devices-assign-node|wifi-toggle|wifi-apply|wifi-disconnect|ports-apply|ports-confirm|subscription-add|subscription-save|subscription-update|subscription-delete|policy-apply|backup-restore|password-set|system-reboot|apply)
		acquire_mutation_lock
		assert_state_writable
		;;
esac

case "$command_name" in
	status) status ;;
	devices) devices ;;
	nodes) nodes ;;
	node-get) node_get "$input" ;;
	node-add) node_add "$input" ;;
	node-update) node_update "$input" ;;
	node-delete) node_delete "$input" ;;
	node-test) node_test "$input" ;;
	health-check) health_check ;;
	egress-check) egress_check "$input" ;;
	device-bind) device_bind "$input" ;;
	devices-assign-node) devices_assign_node "$input" ;;
	wifi-status) wifi_status ;;
	wifi-config) wifi_config ;;
	wifi-toggle) wifi_toggle "$input" ;;
	wifi-apply) wifi_apply "$input" ;;
	wifi-disconnect) wifi_disconnect "$input" ;;
	ports) ports ;;
	ports-apply) ports_apply "$input" ;;
	ports-confirm) ports_confirm ;;
	subscriptions) subscriptions ;;
	subscription-get) subscription_get "$input" ;;
	subscription-add) subscription_add "$input" ;;
	subscription-save) subscription_save "$input" ;;
	subscription-update) subscription_update "$input" ;;
	subscription-delete) subscription_delete "$input" ;;
	policy-settings) policy_settings ;;
	policy-apply) policy_apply "$input" ;;
	backup-create) backup_create ;;
	backup-restore) backup_restore "$input" ;;
	password-set) password_set "$input" ;;
	system-logs) system_logs ;;
	update-check) update_check ;;
	system-reboot) system_reboot ;;
	generate)
		candidate="$(generate_config)"
		mv "$candidate" "$ACTIVE_CONFIG"
		json_ok "\"path\":\"${ACTIVE_CONFIG}\""
		;;
	apply)
		apply_generated_config
		json_ok
		;;
	*) json_error "Unknown command" ;;
esac
