#!/bin/sh

CTL="/usr/libexec/proxyos/proxyosctl"

case "$1" in
	list)
		cat <<'EOF'
{
  "status": {},
  "devices": {},
  "nodes": {},
  "node_get": {"id":""},
  "node_add": {"name":"", "outbound_json":""},
  "node_update": {"id":"", "name":"", "outbound_json":""},
  "node_delete": {"id":""},
  "node_test": {"id":""},
  "health_check": {},
  "egress_check": {"node_id":"", "device_mac":""},
  "device_bind": {"mac":"", "ip":"", "name":"", "connection":"", "type":"", "policy":"", "node_id":"", "backup_node_id":"", "failure_mode":"", "auto_source":""},
  "devices_assign_node": {"node_id":"", "device_macs":[]},
  "wifi_status": {},
  "wifi_config": {},
  "wifi_toggle": {"enabled":true},
  "wifi_apply": {"ssid_24":"", "ssid_5":"", "password":"", "country":"", "encryption":"", "txpower":0, "channel_24":"", "channel_5":"", "htmode_24":"", "htmode_5":"", "guest_enabled":false},
  "wifi_disconnect": {"mac":""},
  "ports": {},
  "ports_apply": {"assignments_json":""},
  "ports_confirm": {},
  "subscriptions": {},
  "subscription_get": {"id":""},
  "subscription_add": {"name":"", "url":""},
  "subscription_save": {"id":"", "name":"", "url":""},
  "subscription_update": {"id":""},
  "subscription_delete": {"id":""},
  "policy_settings": {},
  "policy_apply": {"default_policy":"", "default_node_id":""},
  "remote_access": {},
  "remote_access_apply": {"enabled":false, "wan_enabled":false, "port":10808},
  "remote_access_rotate": {"mac":""},
  "tunnel_status": {},
  "tunnel_connect": {},
  "tunnel_logout": {},
  "backup_create": {},
  "backup_restore": {"data_base64":""},
  "password_set": {"password":""},
  "system_logs": {},
  "update_check": {},
  "system_reboot": {},
  "generate": {},
  "apply": {}
}
EOF
		;;
	call)
		read -r input
		case "$2" in
			status|devices|nodes|ports|ports_confirm|subscriptions|generate|apply|health_check|policy_settings|remote_access|tunnel_status|backup_create|system_logs|update_check|system_reboot)
				exec "$CTL" "$(printf '%s' "$2" | tr '_' '-')" '{}'
				;;
			wifi_status)
				exec "$CTL" wifi-status '{}'
				;;
			wifi_config)
				exec "$CTL" wifi-config '{}'
				;;
			node_get)
				exec "$CTL" node-get "$input"
				;;
			node_add)
				exec "$CTL" node-add "$input"
				;;
			node_update)
				exec "$CTL" node-update "$input"
				;;
			node_delete)
				exec "$CTL" node-delete "$input"
				;;
			node_test)
				exec "$CTL" node-test "$input"
				;;
			egress_check)
				exec "$CTL" egress-check "$input"
				;;
			device_bind)
				exec "$CTL" device-bind "$input"
				;;
			devices_assign_node)
				exec "$CTL" devices-assign-node "$input"
				;;
			wifi_toggle)
				exec "$CTL" wifi-toggle "$input"
				;;
			wifi_apply)
				exec "$CTL" wifi-apply "$input"
				;;
			wifi_disconnect)
				exec "$CTL" wifi-disconnect "$input"
				;;
			ports_apply)
				exec "$CTL" ports-apply "$input"
				;;
			subscription_add)
				exec "$CTL" subscription-add "$input"
				;;
			subscription_get)
				exec "$CTL" subscription-get "$input"
				;;
			subscription_save)
				exec "$CTL" subscription-save "$input"
				;;
			subscription_update)
				exec "$CTL" subscription-update "$input"
				;;
			subscription_delete)
				exec "$CTL" subscription-delete "$input"
				;;
			policy_apply)
				exec "$CTL" policy-apply "$input"
				;;
			remote_access_apply)
				exec "$CTL" remote-access-apply "$input"
				;;
			remote_access_rotate)
				exec "$CTL" remote-access-rotate "$input"
				;;
			tunnel_connect)
				exec "$CTL" tunnel-connect "$input"
				;;
			tunnel_logout)
				exec "$CTL" tunnel-logout "$input"
				;;
			backup_restore)
				exec "$CTL" backup-restore "$input"
				;;
			password_set)
				exec "$CTL" password-set "$input"
				;;
			*)
				printf '{"ok":false,"error":"Unknown method"}\n'
				exit 1
				;;
		esac
		;;
esac
