#!/bin/sh

TAG="proxyos-lan-watch"
STATE_FILE="/etc/proxyos/port-role-detected"
DEVICE_FILE="/tmp/proxyos/lan-devices"
AP_FILE="/tmp/proxyos/ap-devices"
TYPE_FILE="/tmp/proxyos/lan-device-types"
TOPOLOGY_FILE="/tmp/proxyos/lan-topology"
KNOWN_AP_FILE="/etc/proxyos/ap-ports"
INTERVAL="${PROXYOS_LAN_SCAN_INTERVAL:-2}"

log() {
	logger -t "$TAG" "$*"
}

state_value() {
	sed -n "s/^$1=//p" "$STATE_FILE" 2>/dev/null | head -n 1
}

ensure_lan_ports() {
	local port wan lan_ports master
	wan="$(state_value wan)"
	lan_ports="$(state_value lan)"
	[ -n "$lan_ports" ] || lan_ports="$(uci -q get network.br_lan.ports)"
	[ -d /sys/class/net/br-lan ] || return 0
	# Keep quiet, locked mobile clients in the bridge FDB long enough for the
	# controller's external-client presence grace period.
	ip link set dev br-lan type bridge ageing_time 1000 2>/dev/null || true

	for port in $lan_ports; do
		[ "$port" = "$wan" ] && continue
		[ -d "/sys/class/net/$port" ] || continue
		ip link set dev "$port" up 2>/dev/null
		master="$(basename "$(readlink -f "/sys/class/net/$port/master" 2>/dev/null)" 2>/dev/null)"
		if [ "$master" != "br-lan" ]; then
			ip link set dev "$port" master br-lan 2>/dev/null && log "restored $port to br-lan"
		fi
	done
}

lease_for_mac() {
	local wanted="$1"
	awk -v mac="$wanted" 'tolower($2) == mac { print $3 "\t" $4; exit }' /tmp/dhcp.leases 2>/dev/null
}

fdb_entries() {
	local number mac local_flag port path port_number
	if command -v bridge >/dev/null 2>&1; then
		bridge -s fdb show br br-lan 2>/dev/null | \
			awk '$2 == "dev" && $0 !~ /(self|permanent|local)/ {
				age=999999
				for (i=1; i<=NF; i++) if ($i == "used" && (i+1)<=NF) { split($(i+1), times, "/"); age=times[2]+0 }
				print tolower($1), $3, age
			}'
		return
	fi
	command -v brctl >/dev/null 2>&1 || return
	brctl showmacs br-lan 2>/dev/null | while read -r number mac local_flag rest; do
		[ "$local_flag" = "no" ] || continue
		port=""
		for path in /sys/class/net/br-lan/brif/*; do
			[ -e "$path/port_no" ] || continue
			port_number="$(cat "$path/port_no" 2>/dev/null)"
			port_number=$((port_number))
			[ "$port_number" = "$number" ] && { port="${path##*/}"; break; }
		done
		[ -n "$port" ] && printf '%s %s 0\n' "$mac" "$port"
	done
}

scan_devices() {
	local tmp_devices="${DEVICE_FILE}.$$" tmp_ap="${AP_FILE}.$$"
	local tmp_types="${TYPE_FILE}.$$" tmp_topology="${TOPOLOGY_FILE}.$$"
	local mac port activity_age lease ip hostname count carrier device_type evidence port_type lan_ports
	: > "$tmp_devices"
	: > "$tmp_ap"
	: > "$tmp_types"
	: > "$tmp_topology"
	[ -d /sys/class/net/br-lan ] || {
		mv "$tmp_devices" "$DEVICE_FILE"
		mv "$tmp_ap" "$AP_FILE"
		mv "$tmp_types" "$TYPE_FILE"
		mv "$tmp_topology" "$TOPOLOGY_FILE"
		return
	}

	# One learned MAC is a wired device. Multiple learned MACs behind one
	# physical port normally mean an AP or an additional Ethernet switch.
	fdb_entries | while read -r mac port activity_age; do
		mac="$(printf '%s' "$mac" | tr 'A-F' 'a-f')"
		lease="$(lease_for_mac "$mac")"
		ip="${lease%%	*}"
		[ "$ip" != "$lease" ] || ip="-"
		hostname="${lease#*	}"
		[ "$hostname" != "$lease" ] || hostname="-"
		printf '%s\t%s\t%s\t%s\t%s\n' "$mac" "$ip" "$hostname" "$port" "${activity_age:-999999}"
	done | sort -u > "$tmp_devices"

	for port in $(awk '{print $4}' "$tmp_devices" | sort -u); do
		count="$(awk -v p="$port" '$4 == p { n++ } END { print n+0 }' "$tmp_devices")"
		carrier="$(cat "/sys/class/net/$port/carrier" 2>/dev/null)"
		if [ "$count" -ge 2 ]; then
			printf '%s\tonline\t%s\tap-or-switch\n' "$port" "$count" >> "$tmp_ap"
		fi
		[ "$carrier" = "1" ] || continue
		case "$(awk -v p="$port" '$4 == p { print tolower($3) }' "$tmp_devices")" in
			*ap*|*access-point*|*unifi*|*omada*)
				grep -q "^$port[[:space:]]" "$tmp_ap" 2>/dev/null || \
					printf '%s\tonline\t%s\tname-match\n' "$port" "$count" >> "$tmp_ap"
				;;
		esac
	done

	# Classify every device learned on every LAN port. Port number never
	# determines the type; live topology evidence does.
	while IFS="	" read -r mac ip hostname port activity_age; do
		device_type="other"
		evidence="unknown"
		case "$(printf '%s' "$hostname" | tr 'A-Z' 'a-z')" in
			*iphone*|*ipad*|*ios*|*android*|*pixel*|*phone*|*手机*) device_type="phone"; evidence="hostname" ;;
			*desktop*|*laptop*|*macbook*|*computer*|*电脑*) device_type="computer"; evidence="hostname" ;;
			*router*|*gateway*|*路由*) device_type="router"; evidence="hostname" ;;
			*external-ap*|*access-point*|*unifi*|*omada*|*wireless-ap*|*wifi-ap*) device_type="access_point"; evidence="hostname" ;;
		esac
		count="$(awk -v p="$port" '$4 == p { n++ } END { print n+0 }' "$tmp_devices")"
		# An AP in bridge mode often has no DHCP lease of its own while named
		# phone/computer clients behind it are visible. This evidence is more
		# specific than a multi-MAC port, which could be an Ethernet switch.
		if [ "$device_type" = "other" ] && [ "$count" -ge 2 ] && [ "$ip" = "-" ] && \
		   awk -v p="$port" 'tolower($4) == tolower(p) && tolower($3) ~ /(iphone|ipad|ios|android|pixel|phone|desktop|laptop|macbook|computer)/ { found=1 } END { exit !found }' "$tmp_devices" 2>/dev/null; then
			device_type="access_point"
			evidence="infrastructure-mac"
		fi
		if [ "$device_type" = "other" ] && [ "$count" -ge 2 ]; then
			device_type="downstream_device"
			evidence="multi-mac-port"
		fi
		printf '%s\t%s\t%s\t%s\n' "$mac" "$device_type" "$port" "$evidence" >> "$tmp_types"
	done < "$tmp_devices"

	while IFS="	" read -r mac device_type port evidence; do
		[ "$device_type" = "access_point" ] || continue
		printf '%s\tonline\t%s\tinferred-ap\n' "$port" "$(awk -v p="$port" '$4 == p { n++ } END { print n+0 }' "$tmp_devices")" >> "$tmp_ap"
		# Remember the AP identity so a quiet AP management MAC ageing out does
		# not make its active wireless clients look like direct LAN endpoints.
		if ! awk -v p="$port" -v m="$mac" 'tolower($1) == tolower(p) && tolower($2) == tolower(m) { found=1 } END { exit !found }' "$KNOWN_AP_FILE" 2>/dev/null; then
			awk -v p="$port" '$1 != p' "$KNOWN_AP_FILE" 2>/dev/null > "${KNOWN_AP_FILE}.tmp"
			printf '%s\t%s\n' "$port" "$mac" >> "${KNOWN_AP_FILE}.tmp"
			mv "${KNOWN_AP_FILE}.tmp" "$KNOWN_AP_FILE"
			chmod 0600 "$KNOWN_AP_FILE"
		fi
	done < "$tmp_types"

	while read -r port signature_mac rest; do
		[ -n "$port" ] && [ -n "$signature_mac" ] || continue
		signature_mac="$(printf '%s' "$signature_mac" | tr 'A-F' 'a-f')"
		carrier="$(cat "/sys/class/net/$port/carrier" 2>/dev/null)"
		# Preserve the remembered role while the physical link stays up. The AP
		# management MAC and sleeping clients may both be absent from the FDB.
		if [ "$carrier" != "1" ]; then
			awk -v p="$port" '$1 != p' "$KNOWN_AP_FILE" > "${KNOWN_AP_FILE}.tmp"
			mv "${KNOWN_AP_FILE}.tmp" "$KNOWN_AP_FILE"
			chmod 0600 "$KNOWN_AP_FILE"
			continue
		fi
		[ "$carrier" = "1" ] && carrier="online"
		count="$(awk -v p="$port" '$4 == p { n++ } END { print n+0 }' "$tmp_devices")"
		awk -v p="$port" '$1 != p' "$tmp_ap" > "${tmp_ap}.known"
		mv "${tmp_ap}.known" "$tmp_ap"
		printf '%s\t%s\t%s\tconfigured-ap\n' "$port" "$carrier" "$count" >> "$tmp_ap"
	done < "$KNOWN_AP_FILE" 2>/dev/null

	lan_ports="$(state_value lan)"
	[ -n "$lan_ports" ] || lan_ports="$(uci -q get network.br_lan.ports)"
	for port in $lan_ports; do
		[ -d "/sys/class/net/$port" ] || continue
		carrier="$(cat "/sys/class/net/$port/carrier" 2>/dev/null)"
		[ "$carrier" = "1" ] && carrier="online" || carrier="offline"
		count="$(awk -v p="$port" '$4 == p { n++ } END { print n+0 }' "$tmp_devices")"
		port_type="empty"
		if [ "$count" -eq 1 ]; then
			port_type="endpoint"
			case "$(awk -v p="$port" '$3 == p { print $2; exit }' "$tmp_types")" in
				access_point) port_type="access-point" ;;
				router) port_type="router" ;;
			esac
		elif [ "$count" -ge 2 ]; then
			port_type="ap-or-switch"
		fi
		if awk -v p="$port" '$1 == p && $2 == "online" && ($4 == "configured-ap" || $4 == "name-match" || $4 == "inferred-ap") { found=1 } END { exit !found }' "$tmp_ap"; then
			port_type="access-point"
		fi
		printf '%s\t%s\t%s\t%s\n' "$port" "$carrier" "$count" "$port_type" >> "$tmp_topology"
	done

	mv "$tmp_devices" "$DEVICE_FILE"
	mv "$tmp_ap" "$AP_FILE"
	mv "$tmp_types" "$TYPE_FILE"
	mv "$tmp_topology" "$TOPOLOGY_FILE"
}

show_status() {
	printf 'LAN wired devices:\n'
	if [ -s "$DEVICE_FILE" ]; then
		printf 'MAC\tIP\tHOSTNAME\tPORT\tLAST_ACTIVITY_SECONDS\n'
		cat "$DEVICE_FILE"
	else
		printf '(none detected)\n'
	fi
	printf '\nAP candidates:\n'
	if [ -s "$AP_FILE" ]; then
		printf 'PORT\tSTATE\tMAC_COUNT\tREASON\n'
		cat "$AP_FILE"
	else
		printf '(none detected)\n'
	fi
	printf '\nLAN topology:\n'
	if [ -s "$TOPOLOGY_FILE" ]; then
		printf 'PORT\tSTATE\tMAC_COUNT\tTYPE\n'
		cat "$TOPOLOGY_FILE"
	else
		printf '(none detected)\n'
	fi
}

if [ "$1" = "--status" ]; then
	show_status
	exit 0
fi

mkdir -p /tmp/proxyos /etc/proxyos
touch "$KNOWN_AP_FILE"
chmod 0600 "$KNOWN_AP_FILE"
while :; do
	ensure_lan_ports
	scan_devices
	sleep "$INTERVAL"
done
